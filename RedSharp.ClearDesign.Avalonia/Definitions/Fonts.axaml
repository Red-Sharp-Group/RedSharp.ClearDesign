<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="using:RedSharp.ClearDesign.Utils"
                    xmlns:system="using:System">
  
  <!--#################################################################################################-->
  <!--DEFAULT SETTINGS-->
  
  <!--OpenSans: resm:RedSharp.ClearDesign.Resources.Fonts.OpenSans?assembly=RedSharp.ClearDesign#Open Sans-->  
  <!--Oswald: resm:RedSharp.ClearDesign.Resources.Fonts.Oswald?assembly=RedSharp.ClearDesign#Oswald-->  
  <!--Roboto: resm:RedSharp.ClearDesign.Resources.Fonts.Roboto?assembly=RedSharp.ClearDesign#Roboto-->
 
  <!--####################-->
  <!--TITLE1-->
  
  <system:Double x:Key="D_DefaultTitle1FontSize_">20</system:Double>
  <FontWeight x:Key="D_DefaultTitle1FontWeight_">400</FontWeight>
  <FontFamily x:Key="D_DefaultTitle1FontFamily_">resm:RedSharp.ClearDesign.Resources.Fonts.Roboto?assembly=RedSharp.ClearDesign#Roboto</FontFamily>
  
  <!--####################-->
  <!--TITLE2-->
  
  <system:Double x:Key="D_DefaultTitle2FontSize_">16</system:Double>
  <FontWeight x:Key="D_DefaultTitle2FontWeight_">400</FontWeight>
  <FontFamily x:Key="D_DefaultTitle2FontFamily_">resm:RedSharp.ClearDesign.Resources.Fonts.Roboto?assembly=RedSharp.ClearDesign#Roboto</FontFamily>

  <!--####################-->
  <!--TITLE3-->

  <system:Double x:Key="D_DefaultTitle3FontSize_">14</system:Double>
  <FontWeight x:Key="D_DefaultTitle3FontWeight_">400</FontWeight>
  <FontFamily x:Key="D_DefaultTitle3FontFamily_">resm:RedSharp.ClearDesign.Resources.Fonts.Roboto?assembly=RedSharp.ClearDesign#Roboto</FontFamily>

  <!--####################-->
  <!--COMMON-->
  
  <system:Double x:Key="D_DefaultCommonFontSize_">12</system:Double>
  <FontWeight x:Key="D_DefaultCommonFontWeight_">400</FontWeight>
  <FontFamily x:Key="D_DefaultCommonFontFamily_">resm:RedSharp.ClearDesign.Resources.Fonts.Roboto?assembly=RedSharp.ClearDesign#Roboto</FontFamily>

</ResourceDictionary>
