<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="using:System"
                    xmlns:utils="using:RedSharp.ClearDesign.Utils"
                    xmlns:helpers="using:RedSharp.ClearDesign.Helpers">
  
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://RedSharp.ClearDesign/Definitions/Colors.axaml"/>
    <ResourceInclude Source="avares://RedSharp.ClearDesign/Definitions/Sizes.axaml"/>
    <ResourceInclude Source="avares://RedSharp.ClearDesign/Definitions/Fonts.axaml"/>
    <ResourceInclude Source="avares://RedSharp.ClearDesign/Styles/Buttons.axaml"/>
    <ResourceInclude Source="avares://RedSharp.ClearDesign/Styles/Icons.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <Styles x:Key="S_ScrollBarsStyles_">

    <!--#################################################################################################-->
    <!--LEFT/RIGHT TOP/BOTTOM BUTTONS-->
    
    <!--REST-->
    <Style Selector="RepeatButton.scroll">

      <Setter Property="Width"
              Value="16"/>
      <Setter Property="Height"
              Value="16"/>

      <Setter Property="BorderBrush" 
              Value="Transparent"/>
      <Setter Property="BorderThickness" 
              Value="0"/>

      <Setter Property="Padding"
              Value="0"/>

      <Setter Property="Focusable"
              Value="False"/>

      <Setter Property="Background"
              Value="Transparent"/>
      
      <Setter Property="Template">
        <ControlTemplate>

          <!--BORDER-->
          <Border UseLayoutRounding="True"
                  CornerRadius="255"
                  Background="{TemplateBinding BorderBrush}">

            <Panel>
              <!--BACKGROUND-->
              <Border UseLayoutRounding="False"
                      CornerRadius="255"
                      Background="{TemplateBinding Background}"
                      Margin="{TemplateBinding BorderThickness}"/>

              <!--ACCENT-->
              <Border UseLayoutRounding="True"
                      CornerRadius="255"
                      Background="{TemplateBinding helpers:AccentHelper.Color}"
                      Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

              <!--CONTENT-->
              <ContentControl Margin="{TemplateBinding Padding}"
                              UseLayoutRounding="{TemplateBinding helpers:ContentHelper.LayoutRounding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontSize="{TemplateBinding FontSize}"
                              Foreground="{TemplateBinding Foreground}"
                              Content="{TemplateBinding Content}"/>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    
    <!--#################################################################################################-->
    <!--TRACK BUTTONS-->
    
    <!--REST-->
    <Style Selector="RepeatButton.scroll.track">
      <Setter Property="Width"
              Value="{x:Static system:Double.NaN}"/>
      <Setter Property="Height"
              Value="{x:Static system:Double.NaN}"/>

      <Setter Property="HorizontalAlignment"
              Value="Stretch"/>
      <Setter Property="VerticalAlignment"
              Value="Stretch"/>
      
      <Setter Property="helpers:AccentHelper.Color"
              Value="Transparent"/>
    </Style>

    <!--#################################################################################################-->
    <!--THUMB-->

    
    <!--REST-->
    <Style Selector="Thumb.scroll">

      <Setter Property="BorderBrush"
              Value="Transparent"/>
      <Setter Property="BorderThickness"
              Value="0"/>
      
      <Setter Property="Focusable"
              Value="False"/>

      <Setter Property="helpers:AccentHelper.Color"
              Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>

      <Setter Property="helpers:AccentHelper.Opacity"
              Value="0.0"/>
      
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="helpers:AccentHelper.Opacity" Duration="0:0:0.075"/>
        </Transitions>
      </Setter>

      <Setter Property="Template">
        <ControlTemplate>

          <!--BORDER-->
          <Border UseLayoutRounding="True"
                  CornerRadius="255"
                  Background="{TemplateBinding BorderBrush}">
            <Panel>
              
              <!--BACKGROUND-->
              <Border UseLayoutRounding="False"
                      CornerRadius="255"
                      Background="{TemplateBinding Background}"
                      Margin="{TemplateBinding BorderThickness}"/>

              <!--ACCENT-->
              <Border UseLayoutRounding="True"
                      CornerRadius="255"
                      Background="{TemplateBinding helpers:AccentHelper.Color}"
                      Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"
                      Margin="{TemplateBinding helpers:AccentHelper.Margin}"/>

            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False"
                  UseLayoutRounding="False"
                  BorderBrush="{StaticResource S_FocusBorderColorBrush_}"
                  BorderThickness="{Binding Source={StaticResource S_DefaultFocusThicknessFull_}, Path=Value}"
                  Margin="{Binding Source={StaticResource S_OutstandingFocusThicknessFull_}, Path=Value}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>

    <!--HOVER-->
    <Style Selector="Thumb.scroll:pointerover">
      <Setter Property="helpers:AccentHelper.Opacity"
              Value="{DynamicResource D_DefaultAccentHoverOpacity_}"/>
    </Style>

    <!--PRESSED-->
    <Style Selector="Thumb.scroll:pressed">
      <Setter Property="helpers:AccentHelper.Opacity"
              Value="{DynamicResource D_DefaultAccentPressedOpacity_}"/>
    </Style>

    <!--DISABLED-->
    <Style Selector="Thumb.scroll:disabled">
      <Setter Property="OpacityMask"
              Value="{StaticResource S_DisabledStateMaskColorBrush_}"/>

      <Setter Property="Background"
              Value="{StaticResource S_DefaultDisabledAccentColorBrush_}"/>

      <Setter Property="BorderBrush"
              Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>

      <Setter Property="Foreground"
              Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
    </Style>

    <!--#################################################################################################-->
    <!--SCROLL BAR VERTICAL-->
    
    <Style Selector="ScrollBar.vertical">
      <Setter Property="Width"
              Value="16"/>
      
      <Setter Property="Orientation"
              Value="Vertical"/>

      <Setter Property="helpers:ScrollHelper.TrackColor"
              Value="{StaticResource S_Step3ColorBrush_}"/>

      <Setter Property="helpers:ScrollHelper.ThumbColor"
              Value="{StaticResource S_Dark5ColorBrush_}"/>

      <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
              Value="False"/>
      <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
              Value="0"/>
      
      <Setter Property="helpers:ScrollHelper.TrackWidth"
              Value="8"/>
      
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="helpers:ScrollHelper.TrackWidth" Duration="0:0:0.075"/>
          <DoubleTransition Property="helpers:ScrollHelper.RepeatButtonsOpacity" Duration="0:0:0.075"/>
        </Transitions>
      </Setter>

      <Setter Property="Template">
        <ControlTemplate>
          <Border>
            <Grid Width="{TemplateBinding Width}"
                  Background="Transparent">
              <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
              </Grid.RowDefinitions>

              <RepeatButton Grid.Row="0"
                            Name="PART_LineUpButton"
                            Classes="scroll"
                            Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                            IsVisible="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                            helpers:ContentHelper.LayoutRounding="True">
                <Path Classes="icon default"
                      Fill="{StaticResource S_CommonFontColorBrush_}"
                      Data="{StaticResource S_TopArrowLineIconGeometry}"/>
              </RepeatButton>

              <Border Grid.Row="1"
                      Margin="0,2"
                      CornerRadius="255"
                      Background="{TemplateBinding helpers:ScrollHelper.TrackColor}"
                      Width="{TemplateBinding helpers:ScrollHelper.TrackWidth}"/>

              <Track Grid.Row="1"
                     Margin="0,2"
                     Width="{TemplateBinding helpers:ScrollHelper.TrackWidth}"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton"
                                Classes="scroll track"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton"
                                Classes="scroll track"/>
                </Track.IncreaseButton>
                <Thumb Name="thumb"
                       Background="{TemplateBinding helpers:ScrollHelper.ThumbColor}"
                       Classes="scroll"/>
              </Track>

              <RepeatButton Grid.Row="2"
                            Name="PART_LineDownButton"
                            Classes="scroll"
                            Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                            IsVisible="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                            helpers:ContentHelper.LayoutRounding="True">
                <Path Classes="icon default"
                      Fill="{StaticResource S_CommonFontColorBrush_}"
                      Data="{StaticResource S_BottomArrowLineIconGeometry}"/>
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    
    <Style Selector="ScrollBar.vertical.full">
      <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
              Value="True"/>
    </Style>

    <Style Selector="ScrollBar.vertical.full:pointerover">
      <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
              Value="1"/>
    </Style>

    
    <Style Selector="ScrollBar.vertical.resizable">
      <Setter Property="helpers:ScrollHelper.TrackWidth"
              Value="4"/>
    </Style>

    <Style Selector="ScrollBar.vertical.resizable:pointerover">
      <Setter Property="helpers:ScrollHelper.TrackWidth"
              Value="8"/>
    </Style>

    
    <Style Selector="ScrollBar.vertical.resizable.full">
      <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
              Value="True"/>
    </Style>

    <Style Selector="ScrollBar.vertical.resizable.full:pointerover">
      <Setter Property="helpers:ScrollHelper.TrackWidth"
              Value="8"/>
      <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
              Value="1"/>
    </Style>

    
    <Style Selector="ScrollBar.vertical.min">
      <Setter Property="helpers:ScrollHelper.TrackWidth"
              Value="4"/>
      <Setter Property="Width"
              Value="8"/>
    </Style>

    <!--#################################################################################################-->
    <!--SCROLL BAR HORIZONTAL-->

    <Style Selector="ScrollBar.horizontal">
      <Setter Property="Height"
              Value="16"/>

      <Setter Property="Orientation"
              Value="Horizontal"/>

      <Setter Property="helpers:ScrollHelper.TrackColor"
              Value="{StaticResource S_Step3ColorBrush_}"/>

      <Setter Property="helpers:ScrollHelper.ThumbColor"
              Value="{StaticResource S_Dark5ColorBrush_}"/>

      <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
              Value="False"/>
      <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
              Value="0"/>

      <Setter Property="helpers:ScrollHelper.TrackHeight"
              Value="8"/>

      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="helpers:ScrollHelper.TrackHeight" Duration="0:0:0.075"/>
          <DoubleTransition Property="helpers:ScrollHelper.RepeatButtonsOpacity" Duration="0:0:0.075"/>
        </Transitions>
      </Setter>

      <Setter Property="Template">
        <ControlTemplate>
          <Border>
            <Grid Height="{TemplateBinding Height}"
                  Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
              </Grid.ColumnDefinitions>

              <RepeatButton Name="PART_LineUpButton"
                            Classes="scroll"
                            Grid.Column="0"
                            Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                            IsVisible="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                            helpers:ContentHelper.LayoutRounding="True">
                <Path Classes="icon default"
                      Fill="{StaticResource S_CommonFontColorBrush_}"
                      Data="{StaticResource S_LeftArrowLineIconGeometry}"/>
              </RepeatButton>

              <Border Grid.Column="1"
                      Margin="2,0"
                      CornerRadius="255"
                      Background="{TemplateBinding helpers:ScrollHelper.TrackColor}"
                      Height="{TemplateBinding helpers:ScrollHelper.TrackHeight}"/>

              <Track Grid.Column="1"
                     Margin="2,0"
                     Height="{TemplateBinding helpers:ScrollHelper.TrackHeight}"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="False">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton"
                                Classes="scroll track"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton"
                                Classes="scroll track"/>
                </Track.IncreaseButton>
                <Thumb Name="thumb"
                       Background="{TemplateBinding helpers:ScrollHelper.ThumbColor}"
                       Classes="scroll"/>
              </Track>

              <RepeatButton Name="PART_LineDownButton"
                            Classes="scroll"
                            Grid.Column="2"
                            Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                            IsVisible="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                            helpers:ContentHelper.LayoutRounding="True">
                <Path Classes="icon default"
                      Fill="{StaticResource S_CommonFontColorBrush_}"
                      Data="{StaticResource S_RightArrowLineIconGeometry}"/>
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    
    <Style Selector="ScrollBar.horizontal.full">
      <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
              Value="True"/>
    </Style>

    <Style Selector="ScrollBar.horizontal.full:pointerover">
      <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
              Value="1"/>
    </Style>

    
    <Style Selector="ScrollBar.horizontal.resizable">
      <Setter Property="helpers:ScrollHelper.TrackHeight"
              Value="4"/>
    </Style>

    <Style Selector="ScrollBar.horizontal.resizable:pointerover">
      <Setter Property="helpers:ScrollHelper.TrackHeight"
              Value="8"/>
    </Style>

    
    <Style Selector="ScrollBar.horizontal.resizable.full">
      <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
              Value="True"/>
    </Style>

    <Style Selector="ScrollBar.horizontal.resizable.full:pointerover">
      <Setter Property="helpers:ScrollHelper.TrackHeight"
              Value="8"/>
      <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
              Value="1"/>
    </Style>


    <Style Selector="ScrollBar.horizontal.min">
      <Setter Property="helpers:ScrollHelper.TrackHeight"
              Value="4"/>
      <Setter Property="Height"
              Value="8"/>
    </Style>
  </Styles>
</ResourceDictionary>
