                                </Track.Thumb>
                            </Track>

                            <RepeatButton Grid.Column="2"
                                          Name="PART_LineDownButton"
                                          Margin="2,0,0,0"
                                          Style="{StaticResource __RepeatButtonScroll}"
                                          Opacity="0.0"
                                          Command="{x:Static ScrollBar.LineRightCommand}" >
                                <Image Width="16"
                                       Height="16"
