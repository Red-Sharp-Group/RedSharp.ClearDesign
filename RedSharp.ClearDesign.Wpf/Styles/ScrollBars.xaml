<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Animations.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
        <ResourceDictionary Source="RepeatButtons.xaml"/>
        <ResourceDictionary Source="Thumbs.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <utils:DoubleAnimationDescription x:Key="__AnimationDescriptionThumbAppeared"
                                      TargetName="PART_Thumb"
                                      TargetProperty="Opacity"
                                      From="0.5"
                                      To="1.0"
                                      Duration="0:0:0.075"/>

    <utils:DoubleAnimationDescription x:Key="__AnimationDescriptionLineUpAppeared"
                                      TargetName="PART_LineUpButton"
                                      TargetProperty="Opacity"
                                      From="0.0"
                                      To="1.0"
                                      Duration="0:0:0.075"/>

    <utils:DoubleAnimationDescription x:Key="__AnimationDescriptionLineDownAppeared"
                                      TargetName="PART_LineDownButton"
                                      TargetProperty="Opacity"
                                      From="0.0"
                                      To="1.0"
                                      Duration="0:0:0.075"/>

    <utils:ThicknessAnimationDescription x:Key="__AnimationDescriptionHorizontalScrollAppeared"
                                         TargetProperty="Padding"
                                         From="0,6"
                                         To="0,4"
                                         Duration="0:0:0.075"/>

    <utils:ThicknessAnimationDescription x:Key="__AnimationDescriptionVerticalScrollAppeared"
                                         TargetProperty="Padding"
                                         From="6,0"
                                         To="4,0"
                                         Duration="0:0:0.075"/>



    <Style x:Key="__RepeatButtonScroll"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource RepeatButtonMenu}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="16"/>
            <Setter Property="MinHeight"
                    Value="16"/>

            <Setter Property="Width"
                    Value="16"/>
            <Setter Property="Height"
                    Value="16"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Focusable"
                    Value="False"/>
        </Style.Setters>
    </Style>

    <Style x:Key="__RepeatButtonScrollTrack"
           TargetType="{x:Type RepeatButton}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{x:Static system:Double.NaN}"/>
            <Setter Property="Height"
                    Value="{x:Static system:Double.NaN}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="__ThumbScroll"
           TargetType="{x:Type Thumb}"
           BasedOn="{StaticResource ThumbDefault}">
        <Style.Setters>
            <Setter Property="utils:Control.CornerRadius"
                    Value="1000"/>
        </Style.Setters>
    </Style>

    <!--#################################################################################################-->
    <!--VERTICAL-->

    <Style x:Key="ScrollBarVerticalFull"
           TargetType="{x:Type ScrollBar}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="0"/>
            
            <Setter Property="Width"
                    Value="16"/>

            <Setter Property="Padding"
                    Value="6,0"/>

            <Setter Property="Background"
                    Value="{DynamicResource BrushPanelsBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushSubtitleForeground}"/>

            <Setter Property="Orientation"
                    Value="Vertical"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <RepeatButton Grid.Row="0"
                                          Name="PART_LineUpButton"
                                          Margin="0,0,0,2"
                                          Style="{StaticResource __RepeatButtonScroll}"
                                          Opacity="0.0"
                                          Command="{x:Static ScrollBar.LineUpCommand}">
                                <Image Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Source="{StaticResource DrawingImageSimpleArrowTop}"/>
                            </RepeatButton>

                            <controls:RoundBorder Grid.Row="1" 
                                                  CornerRadius="1000"
                                                  Margin="{TemplateBinding Padding}"
                                                  Background="{TemplateBinding Background}"/>

                            <Track Grid.Row="1"
                                   Margin="{TemplateBinding Padding}"
                                   Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Name="PART_PageUpButton"
                                                  Style="{StaticResource __RepeatButtonScrollTrack}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Name="PART_PageDownButton"
                                                  Style="{StaticResource __RepeatButtonScrollTrack}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Name="PART_Thumb"
                                           Style="{StaticResource __ThumbScroll}"
                                           Background="{TemplateBinding Foreground}"
                                           Opacity="0.5"/>
                                </Track.Thumb>
                            </Track>

                            <RepeatButton Grid.Row="2"
                                          Name="PART_LineDownButton"
                                          Margin="0,2,0,0"
                                          Style="{StaticResource __RepeatButtonScroll}"
                                          Opacity="0.0"
                                          Command="{x:Static ScrollBar.LineDownCommand}" >
                                <Image Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Source="{StaticResource DrawingImageSimpleArrowDown}"/>
                            </RepeatButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" 
                                     Value="True">
                                <Trigger.EnterActions>
                                    <utils:DoubleAnimationGenerator IsEnter="True">
                                        <StaticResource ResourceKey="__AnimationDescriptionThumbAppeared"/>
                                        <StaticResource ResourceKey="__AnimationDescriptionLineUpAppeared"/>
                                        <StaticResource ResourceKey="__AnimationDescriptionLineDownAppeared"/>
                                    </utils:DoubleAnimationGenerator>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <utils:DoubleAnimationGenerator IsEnter="False">
                                        <StaticResource ResourceKey="__AnimationDescriptionThumbAppeared"/>
                                        <StaticResource ResourceKey="__AnimationDescriptionLineUpAppeared"/>
                                        <StaticResource ResourceKey="__AnimationDescriptionLineDownAppeared"/>
                                    </utils:DoubleAnimationGenerator>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="PART_Thumb"
                                        Property="Opacity"
                                        Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <utils:ThicknessAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="__AnimationDescriptionVerticalScrollAppeared"/>
                    </utils:ThicknessAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:ThicknessAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="__AnimationDescriptionVerticalScrollAppeared"/>
                    </utils:ThicknessAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity"
                        Value="0.40"/>
                <Setter Property="Background"
                        Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource BrushDisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollBarVerticalMinimal"
           TargetType="{x:Type ScrollBar}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="0"/>
            
            <Setter Property="Width"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="4,0"/>

            <Setter Property="Background"
                    Value="{DynamicResource BrushPanelsBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushSubtitleForeground}"/>

            <Setter Property="Orientation"
                    Value="Vertical"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <controls:RoundBorder Grid.Row="0" 
                                                  CornerRadius="1000"
                                                  Margin="{TemplateBinding Padding}"
                                                  Background="{TemplateBinding Background}"/>

                            <Track Grid.Row="0"
                                   Margin="{TemplateBinding Padding}"
                                   Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Name="PART_PageUpButton"
                                                  Style="{StaticResource __RepeatButtonScrollTrack}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Name="PART_PageDownButton"
                                                  Style="{StaticResource __RepeatButtonScrollTrack}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" 
                                           Style="{StaticResource __ThumbScroll}"
                                           Background="{TemplateBinding Foreground}"
                                           Opacity="0.5"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" 
                                     Value="True">
                                <Trigger.EnterActions>
                                    <utils:DoubleAnimationGenerator IsEnter="True">
                                        <StaticResource ResourceKey="__AnimationDescriptionThumbAppeared"/>
                                    </utils:DoubleAnimationGenerator>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <utils:DoubleAnimationGenerator IsEnter="False">
                                        <StaticResource ResourceKey="__AnimationDescriptionThumbAppeared"/>
                                    </utils:DoubleAnimationGenerator>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="PART_Thumb"
                                        Property="Opacity"
                                        Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity"
                        Value="0.40"/>
                <Setter Property="Background"
                        Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource BrushDisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--#################################################################################################-->
    <!--HORIZONTAL-->

