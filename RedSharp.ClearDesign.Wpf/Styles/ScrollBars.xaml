<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/RepeatButtons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="repeatbutton-scroll"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="16"/>
            <Setter Property="Height"
                    Value="16"/>

            <Setter Property="BorderBrush" 
                    Value="Transparent"/>
            <Setter Property="BorderThickness" 
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid>
                            <Border UseLayoutRounding="True"
                                    CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                    Background="{TemplateBinding BorderBrush}">
                                <Border UseLayoutRounding="False"
                                        CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                        Background="{TemplateBinding Background}"
                                        Margin="{TemplateBinding BorderThickness}">
                                </Border>
                            </Border>

                            <Border UseLayoutRounding="True"
                                    CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                    Background="{TemplateBinding helpers:AccentHelper.Color}"
                                    Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

                            <ContentControl UseLayoutRounding="False" 
                                            Focusable="False"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="repeatbutton-scroll-track"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-scroll}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{x:Static system:Double.NaN}"/>
            <Setter Property="Height"
                    Value="{x:Static system:Double.NaN}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <Setter Property="helpers:AccentHelper.Color"
                    Value="Transparent"/>
        </Style.Setters>
    </Style>

    <Style x:Key="thumb-scroll"
           TargetType="{x:Type Thumb}">
        <Style.Setters>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="helpers:AccentHelper.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="helpers:AccentHelper.Opacity"
                    Value="0.0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">

                        <!--BORDER-->
                        <Border UseLayoutRounding="True"
                                CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                Background="{TemplateBinding BorderBrush}">
                            <Grid>

                                <!--BACKGROUND-->
                                <Border UseLayoutRounding="False"
                                        CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                        Background="{TemplateBinding Background}"
                                        Margin="{TemplateBinding BorderThickness}"/>

                                <!--ACCENT-->
                                <Border UseLayoutRounding="True"
                                        CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                        Background="{TemplateBinding helpers:AccentHelper.Color}"
                                        Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>            
        </Style.Triggers>
    </Style>

    <Style x:Key="scrollbar-vertical"
           TargetType="{x:Type ScrollBar}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="16"/>

            <Setter Property="Orientation"
                    Value="Vertical"/>

            <Setter Property="helpers:ScrollHelper.TrackColor"
                    Value="{StaticResource S_Step3ColorBrush_}"/>

            <Setter Property="helpers:ScrollHelper.ThumbColor"
                    Value="{StaticResource S_Dark5ColorBrush_}"/>

            <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
                    Value="Visible"/>
            <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
                    Value="1"/>

            <Setter Property="helpers:ScrollHelper.TrackWidth"
                    Value="8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border>
                            <Grid Width="{TemplateBinding Width}"
                                  Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <RepeatButton Grid.Row="0"
                                              Name="PART_LineUpButton"
                                              UseLayoutRounding="True"
                                              Style="{StaticResource repeatbutton-scroll}"
                                              Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                                              Visibility="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                                              Command="{x:Static ScrollBar.LineUpCommand}">
                                    <Path Style="{StaticResource icon-default}"
                                          Fill="{StaticResource S_CommonFontColorBrush_}"
                                          Data="{StaticResource S_TopArrowLineIconGeometry}"/>
                                </RepeatButton>

                                <Border Grid.Row="1"
                                        Margin="0,2"
                                        CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                        Background="{TemplateBinding helpers:ScrollHelper.TrackColor}"
                                        Width="{TemplateBinding helpers:ScrollHelper.TrackWidth}"/>

                                <Track Grid.Row="1"
                                       Margin="0,2"
                                       Name="PART_Track"
                                       Width="{TemplateBinding helpers:ScrollHelper.TrackWidth}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Name="PART_PageUpButton"
                                                      Style="{StaticResource repeatbutton-scroll-track}"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Name="PART_PageDownButton"
                                                      Style="{StaticResource repeatbutton-scroll-track}"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource thumb-scroll}"
                                               Background="{TemplateBinding helpers:ScrollHelper.ThumbColor}"/>
                                    </Track.Thumb>                                    
                                </Track>

                                <RepeatButton Grid.Row="2"
                                              Name="PART_LineDownButton"
                                              UseLayoutRounding="True"
                                              Style="{StaticResource repeatbutton-scroll}"
                                              Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                                              Visibility="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                                              Command="{x:Static ScrollBar.LineDownCommand}" >
                                    <Path Style="{StaticResource icon-default}"
                                          Fill="{StaticResource S_CommonFontColorBrush_}"
                                          Data="{StaticResource S_BottomArrowLineIconGeometry}"/>
                                </RepeatButton>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            
        </Style.Triggers>
    </Style>

    <Style x:Key="scrollbar-horizontal"
           TargetType="{x:Type ScrollBar}">
        <Style.Setters>
            <Setter Property="Height"
                    Value="16"/>

            <Setter Property="Orientation"
                    Value="Horizontal"/>

            <Setter Property="helpers:ScrollHelper.TrackColor"
                    Value="{StaticResource S_Step3ColorBrush_}"/>

            <Setter Property="helpers:ScrollHelper.ThumbColor"
                    Value="{StaticResource S_Dark5ColorBrush_}"/>

            <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
                    Value="Visible"/>
            <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
                    Value="1"/>

            <Setter Property="helpers:ScrollHelper.TrackHeight"
                    Value="8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border>
                            <Grid Height="{TemplateBinding Height}"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <RepeatButton Grid.Column="0"
                                              Name="PART_LineUpButton"
                                              UseLayoutRounding="True"
                                              Style="{StaticResource repeatbutton-scroll}"
                                              Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                                              Visibility="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                                              Command="{x:Static ScrollBar.LineLeftCommand}">
                                    <Path Style="{StaticResource icon-default}"
                                          Fill="{StaticResource S_CommonFontColorBrush_}"
                                          Data="{StaticResource S_LeftArrowLineIconGeometry}"/>
                                </RepeatButton>

                                <Border Grid.Column="1"
                                        Margin="2,0"
                                        CornerRadius="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={x:Static helpers:ScrollHelper.RadiusConverter}}"
                                        Background="{TemplateBinding helpers:ScrollHelper.TrackColor}"
                                        Height="{TemplateBinding helpers:ScrollHelper.TrackHeight}"/>

                                <Track Grid.Column="1"
                                       Margin="2,0"
                                       Name="PART_Track"
                                       Height="{TemplateBinding helpers:ScrollHelper.TrackHeight}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Name="PART_PageUpButton"
                                                      Style="{StaticResource repeatbutton-scroll-track}"
                                                      Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Name="PART_PageDownButton"
                                                      Style="{StaticResource repeatbutton-scroll-track}"
                                                      Command="{x:Static ScrollBar.PageRightCommand}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource thumb-scroll}"
                                               Background="{TemplateBinding helpers:ScrollHelper.ThumbColor}"/>
                                    </Track.Thumb>                                    
                                </Track>

                                <RepeatButton Grid.Column="2"
                                              Name="PART_LineDownButton"
                                              UseLayoutRounding="True"
                                              Style="{StaticResource repeatbutton-scroll}"
                                              Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                                              Visibility="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}"
                                              Command="{x:Static ScrollBar.LineRightCommand}" >
                                    <Path Style="{StaticResource icon-default}"
                                          Fill="{StaticResource S_CommonFontColorBrush_}"
                                          Data="{StaticResource S_RightArrowLineIconGeometry}"/>
                                </RepeatButton>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            
        </Style.Triggers>
    </Style>

    <Style x:Key="scrollviewer-default"
           TargetType="{x:Type ScrollViewer}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <AdornerDecorator Grid.Column="0"
                                              Grid.Row="0"
                                              Grid.ColumnSpan="3"
                                              Grid.RowSpan="3">
                                <ScrollContentPresenter Name="PART_ScrollContentPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Local"
                                                        Content="{TemplateBinding ContentControl.Content}"
                                                        ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                        Margin="{TemplateBinding Padding}"/>
                            </AdornerDecorator>

                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Style="{StaticResource scrollbar-vertical}"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}"
                                       Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}"
                                       
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       Focusable="False"/>

                            <ScrollBar Name="PART_HorizontalScrollBar"
                                       Style="{StaticResource scrollbar-horizontal}"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}"
                                       Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}"
                                       
                                       Grid.Column="1"
                                       Grid.Row="2"
                                       Focusable="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>

        </Style.Triggers>
    </Style>

</ResourceDictionary>