<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/RepeatButtons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="repeatbutton-scroll"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="16"/>
            <Setter Property="Height"
                    Value="16"/>

            <Setter Property="BorderBrush" 
                    Value="Transparent"/>
            <Setter Property="BorderThickness" 
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid>
                            <Border UseLayoutRounding="True"
                                    CornerRadius="4"
                                    Background="{TemplateBinding BorderBrush}">
                                <Border UseLayoutRounding="False"
                                        CornerRadius="4"
                                        Background="{TemplateBinding Background}"
                                        Margin="{TemplateBinding BorderThickness}">
                                </Border>
                            </Border>

                            <Border UseLayoutRounding="True"
                                    CornerRadius="4"
                                    Background="{TemplateBinding helpers:AccentHelper.Color}"
                                    Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

                            <ContentControl UseLayoutRounding="False" 
                                            Focusable="False"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="repeatbutton-scroll-track"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-scroll}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{x:Static system:Double.NaN}"/>
            <Setter Property="Height"
                    Value="{x:Static system:Double.NaN}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <Setter Property="helpers:AccentHelper.Color"
                    Value="Transparent"/>
        </Style.Setters>
    </Style>

    <Style x:Key="thumb-scroll"
           TargetType="{x:Type Thumb}">
        <Style.Setters>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="helpers:AccentHelper.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="helpers:AccentHelper.Opacity"
                    Value="0.0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">

                        <!--BORDER-->
                        <Border UseLayoutRounding="True"
                                CornerRadius="255"
                                Background="{TemplateBinding BorderBrush}">
                            <Grid>

                                <!--BACKGROUND-->
                                <Border UseLayoutRounding="False"
                                        CornerRadius="255"
                                        Background="{TemplateBinding Background}"
                                        Margin="{TemplateBinding BorderThickness}"/>

                                <!--ACCENT-->
                                <Border UseLayoutRounding="True"
                                        CornerRadius="255"
                                        Background="{TemplateBinding helpers:AccentHelper.Color}"
                                        Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>            
        </Style.Triggers>
    </Style>

    <Style x:Key="scrollbar-vertical"
           TargetType="{x:Type ScrollBar}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="16"/>

            <Setter Property="Orientation"
                    Value="Vertical"/>

            <Setter Property="helpers:ScrollHelper.TrackColor"
                    Value="{StaticResource S_Step3ColorBrush_}"/>

            <Setter Property="helpers:ScrollHelper.ThumbColor"
                    Value="{StaticResource S_Dark5ColorBrush_}"/>

            <Setter Property="helpers:ScrollHelper.RepeatButtonsVisible"
                    Value="Hidden"/>
            <Setter Property="helpers:ScrollHelper.RepeatButtonsOpacity"
                    Value="0"/>

            <Setter Property="helpers:ScrollHelper.TrackWidth"
                    Value="8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border>
                            <Grid Width="{TemplateBinding Width}"
                                  Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <RepeatButton Grid.Row="0"
                                              Name="PART_LineUpButton"
                                              UseLayoutRounding="True"
                                              Style="{StaticResource repeatbutton-scroll}"
                                              Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                                              Visibility="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}">
                                    <Path Style="{StaticResource icon-default}"
                                          Fill="{StaticResource S_CommonFontColorBrush_}"
                                          Data="{StaticResource S_TopArrowLineIconGeometry}"/>
                                </RepeatButton>

                                <Border Grid.Row="1"
                                        Margin="0,2"
                                        CornerRadius="4"
                                        Background="{TemplateBinding helpers:ScrollHelper.TrackColor}"
                                        Width="{TemplateBinding helpers:ScrollHelper.TrackWidth}"/>

                                <Track Grid.Row="1"
                                       Margin="0,2"
                                       Name="PART_Track"
                                       Width="{TemplateBinding helpers:ScrollHelper.TrackWidth}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Name="PART_PageUpButton"
                                                      Style="{StaticResource repeatbutton-scroll-track}"
                                                      Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Background="Red"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Name="PART_PageDownButton"
                                                      Style="{StaticResource repeatbutton-scroll-track}"
                                                      Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Background="Green"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource thumb-scroll}"
                                               Background="{TemplateBinding helpers:ScrollHelper.ThumbColor}"/>
                                    </Track.Thumb>                                    
                                </Track>

                                <RepeatButton Grid.Row="2"
                                              Name="PART_LineDownButton"
                                              UseLayoutRounding="True"
                                              Style="{StaticResource repeatbutton-scroll}"
                                              Opacity="{TemplateBinding helpers:ScrollHelper.RepeatButtonsOpacity}"
                                              Visibility="{TemplateBinding helpers:ScrollHelper.RepeatButtonsVisible}">
                                    <Path Style="{StaticResource icon-default}"
                                          Fill="{StaticResource S_CommonFontColorBrush_}"
                                          Data="{StaticResource S_BottomArrowLineIconGeometry}"/>
                                </RepeatButton>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            
        </Style.Triggers>
    </Style>

</ResourceDictionary>