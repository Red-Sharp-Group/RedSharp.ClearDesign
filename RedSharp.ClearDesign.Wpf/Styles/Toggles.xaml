<ResourceDictionary x:Class="RedSharp.ClearDesign.Styles.Toggles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
        <ResourceDictionary Source="../Styles/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="checkbox-default"
           TargetType="{x:Type CheckBox}">
        <Style.Setters>
            <Setter Property="BorderBrush" 
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{DynamicResource D_DefaultBorderThicknessFull_}"/>

            <Setter Property="Background"
                    Value="{StaticResource S_FieldsColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource D_DefaultCommonFontFamily_}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource D_DefaultCommonFontSize_}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource D_DefaultCommonFontWeight_}"/>

            <Setter Property="Padding"
                    Value="{DynamicResource D_DefaultPaddingThicknessLeft_}"/>

            <Setter Property="HorizontalAlignment" 
                    Value="Left"/>
            <Setter Property="VerticalAlignment" 
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment" 
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment" 
                    Value="Center"/>

            <Setter Property="extra:AccentsExtra.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="extra:AccentsExtra.Opacity"
                    Value="0.0"/>

            <Setter Property="extra:TogglesExtra.FalseIconColor"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>
            <Setter Property="extra:TogglesExtra.FalseIconVisibility"
                    Value="Visible"/>

            <Setter Property="extra:TogglesExtra.NullIconColor"
                    Value="{StaticResource S_PrimaryFontColorBrush_}"/>
            <Setter Property="extra:TogglesExtra.NullIconVisibility"
                    Value="Hidden"/>

            <Setter Property="extra:TogglesExtra.TrueIconColor"
                    Value="{StaticResource S_PrimaryFontColorBrush_}"/>
            <Setter Property="extra:TogglesExtra.TrueIconVisibility"
                    Value="Hidden"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding-checkbox}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent"
                              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="{DynamicResource D_DefaultToggleHeight_}"
                                  Height="{DynamicResource D_DefaultToggleHeight_}">    
                                
                                <!--BACKGROUND-->
                                <Border UseLayoutRounding="True"
                                        Background="{TemplateBinding BorderBrush}">
                                    <Border UseLayoutRounding="False"
                                            Background="{TemplateBinding Background}"
                                            Margin="{TemplateBinding BorderThickness}"/>
                                </Border>

                                <!--ACCENT-->
                                <Border UseLayoutRounding="True"
                                        Background="{TemplateBinding extra:AccentsExtra.Color}"
                                        Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>

                                <!--ICONS-->
                                <Grid UseLayoutRounding="False"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">
                                    <Path Style="{StaticResource icon-min}"
                                          StrokeThickness="2"
                                          Stroke="{TemplateBinding extra:TogglesExtra.TrueIconColor}"
                                          Visibility="{TemplateBinding extra:TogglesExtra.TrueIconVisibility}"
                                          Data="{StaticResource S_CheckIconGeometry_}"/>

                                    <Path Style="{StaticResource icon-min}"
                                          StrokeThickness="2"
                                          Stroke="{TemplateBinding extra:TogglesExtra.NullIconColor}"
                                          Visibility="{TemplateBinding extra:TogglesExtra.NullIconVisibility}"
                                          Data="{StaticResource S_NullIconGeometry_}"/>
                                </Grid>
                            </Grid>

                            <!--CONTENT-->
                            <ContentControl UseLayoutRounding="False"
                                            Grid.Column="1"
                                            Focusable="False"                                            
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource S_PrimaryBorderColorBrush_}"/>
                <Setter Property="Background" Value="{StaticResource S_PrimaryColorBrush_}"/>
                <Setter Property="extra:TogglesExtra.FalseIconVisibility" Value="Hidden"/>
                <Setter Property="extra:TogglesExtra.TrueIconVisibility" Value="Visible"/>
            </Trigger>

            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter Property="BorderBrush" Value="{StaticResource S_PrimaryBorderColorBrush_}"/>
                <Setter Property="Background" Value="{StaticResource S_PrimaryColorBrush_}"/>
                <Setter Property="extra:TogglesExtra.FalseIconVisibility" Value="Hidden"/>
                <Setter Property="extra:TogglesExtra.NullIconVisibility" Value="Visible"/>
            </Trigger>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="OpacityMask"
                        Value="{StaticResource S_DisabledStateMaskColorBrush_}"/>
                <Setter Property="Background"
                        Value="{StaticResource S_DefaultDisabledAccentColorBrush_}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                
                <Setter Property="extra:TogglesExtra.TrueIconColor"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                <Setter Property="extra:TogglesExtra.NullIconColor"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                <Setter Property="extra:TogglesExtra.FalseIconColor"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="checkbox-switch"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource checkbox-default}">
        <Style.Setters>
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding-switch}"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="{DynamicResource D_SwitchToggleWidth_}"
                                  Height="{DynamicResource D_RoundToggleHeight_}">
                                
                                <!--BACKGROUND-->
                                <Border UseLayoutRounding="True"
                                        SizeChanged="OnBorderSizeChanged"                                        
                                        Background="{TemplateBinding BorderBrush}">
                                    <Border UseLayoutRounding="False"
                                            SizeChanged="OnBorderSizeChanged"                                            
                                            Background="{TemplateBinding Background}"
                                            Margin="{TemplateBinding BorderThickness}"/>                                    
                                </Border>

                                <!--ACCENT-->
                                <Border UseLayoutRounding="True"
                                        SizeChanged="OnBorderSizeChanged"                                        
                                        Background="{TemplateBinding extra:AccentsExtra.Color}"
                                        Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>

                                <!--ICONS-->
                                <Grid UseLayoutRounding="False" 
                                      Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Fill="{TemplateBinding extra:TogglesExtra.FalseIconColor}"
                                             Visibility="{TemplateBinding extra:TogglesExtra.FalseIconVisibility}"/>

                                    <Ellipse Grid.Column="2"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Fill="{TemplateBinding extra:TogglesExtra.TrueIconColor}"
                                             Visibility="{TemplateBinding extra:TogglesExtra.TrueIconVisibility}"/>
                                </Grid>
                            </Grid>

                            <ContentControl UseLayoutRounding="False"
                                            Grid.Column="1"
                                            Focusable="False"                                            
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="checkbox-radio"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource checkbox-default}">
        <Style.Setters>
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding-radio}"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="{DynamicResource D_RoundToggleHeight_}"
                                  Height="{DynamicResource D_RoundToggleHeight_}">
                                
                                <!--BACKGROUND-->
                                <Border UseLayoutRounding="True"
                                        SizeChanged="OnBorderSizeChanged"
                                        Background="{TemplateBinding BorderBrush}">
                                    <Border UseLayoutRounding="False"
                                            SizeChanged="OnBorderSizeChanged"
                                            Background="{TemplateBinding Background}"
                                            Margin="{TemplateBinding BorderThickness}"/>
                                </Border>

                                <!--ACCENT-->
                                <Border UseLayoutRounding="True"
                                        SizeChanged="OnBorderSizeChanged"
                                        Background="{TemplateBinding extra:AccentsExtra.Color}"
                                        Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>

                                <!--ICONS-->
                                <Grid UseLayoutRounding="False">
                                    <Ellipse VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Margin="5"                           
                                             Fill="{TemplateBinding extra:TogglesExtra.TrueIconColor}"
                                             Visibility="{TemplateBinding extra:TogglesExtra.TrueIconVisibility}"/>

                                    <Path Style="{StaticResource icon-min}"
                                          StrokeThickness="2"
                                          Margin="1"
                                          Stroke="{TemplateBinding extra:TogglesExtra.NullIconColor}"
                                          Visibility="{TemplateBinding extra:TogglesExtra.NullIconVisibility}"
                                          Data="{StaticResource S_NullIconGeometry_}"/>
                                </Grid>
                            </Grid>

                            <ContentControl UseLayoutRounding="False" 
                                            Focusable="False"
                                            Grid.Column="1"
                                            Margin="{DynamicResource D_DefaultPaddingThicknessLeft_}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>


