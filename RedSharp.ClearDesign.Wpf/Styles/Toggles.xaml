<ResourceDictionary x:Class="RedSharp.ClearDesign.Styles.Toggles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
        <ResourceDictionary Source="../Styles/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="checkbox-default"
           TargetType="{x:Type CheckBox}">
        <Style.Setters>
            <Setter Property="BorderBrush" 
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{Binding Source={StaticResource S_DefaultBorderThicknessFull_}, Path=Value}"/>

            <Setter Property="Background"
                    Value="{StaticResource S_FieldsColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource D_DefaultCommonFontFamily_}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource D_DefaultCommonFontSize_}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource D_DefaultCommonFontWeight_}"/>

            <Setter Property="HorizontalAlignment" 
                    Value="Left"/>
            <Setter Property="VerticalAlignment" 
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment" 
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment" 
                    Value="Center"/>

            <Setter Property="helpers:AccentHelper.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="helpers:AccentHelper.Opacity"
                    Value="0.0"/>

            <Setter Property="helpers:TogglesHelper.FalseIconColor"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>
            <Setter Property="helpers:TogglesHelper.FalseIconVisibility"
                    Value="Visible"/>

            <Setter Property="helpers:TogglesHelper.NullIconColor"
                    Value="{StaticResource S_PrimaryFontColorBrush_}"/>
            <Setter Property="helpers:TogglesHelper.NullIconVisibility"
                    Value="Hidden"/>

            <Setter Property="helpers:TogglesHelper.TrueIconColor"
                    Value="{StaticResource S_PrimaryFontColorBrush_}"/>
            <Setter Property="helpers:TogglesHelper.TrueIconVisibility"
                    Value="Hidden"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent"
                              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <!--BORDER-->
                            <Border Grid.Column="0"
                                    UseLayoutRounding="True"
                                    Background="{TemplateBinding BorderBrush}"
                                    Width="{DynamicResource D_DefaultToggleHeight_}"
                                    Height="{DynamicResource D_DefaultToggleHeight_}">

                                <Grid>    
                                    <!--BACKGROUND-->
                                    <Border UseLayoutRounding="False"
                                            Margin="{TemplateBinding BorderThickness}"
                                            Background="{TemplateBinding Background}"/>

                                    <!--ACCENT-->
                                    <Border UseLayoutRounding="True"
                                            Background="{TemplateBinding helpers:AccentHelper.Color}"
                                            Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

                                    <!--ICONS-->
                                    <Border Margin="{TemplateBinding Padding}"
                                            UseLayoutRounding="False">

                                        <Grid> 
                                            <Path Style="{StaticResource icon-min}"
                                                  StrokeThickness="2"
                                                  Stroke="{TemplateBinding helpers:TogglesHelper.TrueIconColor}"
                                                  Visibility="{TemplateBinding helpers:TogglesHelper.TrueIconVisibility}"
                                                  Data="{StaticResource S_CheckIconGeometry_}"/>

                                            <Path Style="{StaticResource icon-min}"
                                                  StrokeThickness="2"
                                                  Stroke="{TemplateBinding helpers:TogglesHelper.NullIconColor}"
                                                  Visibility="{TemplateBinding helpers:TogglesHelper.NullIconVisibility}"
                                                  Data="{StaticResource S_NullIconGeometry_}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!--CONTENT-->
                            <ContentControl Grid.Column="1"
                                            UseLayoutRounding="False"
                                            Margin="{Binding Source={StaticResource S_DefaultPaddingThicknessLeft_}, Path=Value}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource S_PrimaryBorderColorBrush_}"/>
                <Setter Property="Background" Value="{StaticResource S_PrimaryColorBrush_}"/>
                <Setter Property="helpers:TogglesHelper.FalseIconVisibility" Value="Hidden"/>
                <Setter Property="helpers:TogglesHelper.TrueIconVisibility" Value="Visible"/>
            </Trigger>

            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter Property="BorderBrush" Value="{StaticResource S_PrimaryBorderColorBrush_}"/>
                <Setter Property="Background" Value="{StaticResource S_PrimaryColorBrush_}"/>
                <Setter Property="helpers:TogglesHelper.FalseIconVisibility" Value="Hidden"/>
                <Setter Property="helpers:TogglesHelper.NullIconVisibility" Value="Visible"/>
            </Trigger>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="checkbox-switch"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource checkbox-default}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <!--BORDER-->
                            <Border Width="{Binding Source={StaticResource S_SwitchToggleWidth_}, Path=Value}"
                                    Height="{Binding Source={StaticResource S_RoundToggleHeight_}, Path=Value}"
                                    UseLayoutRounding="True"
                                    SizeChanged="OnBorderSizeChanged"
                                    Background="{TemplateBinding BorderBrush}">

                                <Grid>
                                    <!--BACKGROUND-->
                                    <Border UseLayoutRounding="False"
                                            SizeChanged="OnBorderSizeChanged"
                                            Background="{TemplateBinding Background}"
                                            Margin="{TemplateBinding BorderThickness}"/>

                                    <!--EFFECT-->
                                    <Border UseLayoutRounding="True"
                                            SizeChanged="OnBorderSizeChanged"
                                            Background="{TemplateBinding helpers:AccentHelper.Color}"
                                            Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

                                    <!--ICONS-->
                                    <Border Margin="{TemplateBinding BorderThickness}"
                                            UseLayoutRounding="False">
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="2"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalAlignment="Stretch"
                                                     Fill="{TemplateBinding helpers:TogglesHelper.FalseIconColor}"
                                                     Visibility="{TemplateBinding helpers:TogglesHelper.FalseIconVisibility}"/>

                                            <Ellipse Grid.Column="2"
                                                     VerticalAlignment="Stretch"
                                                     HorizontalAlignment="Stretch"
                                                     Fill="{TemplateBinding helpers:TogglesHelper.TrueIconColor}"
                                                     Visibility="{TemplateBinding helpers:TogglesHelper.TrueIconVisibility}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <ContentControl x:Name="PART_Content"
                                            Grid.Column="1"
                                            Margin="{Binding Source={StaticResource S_DefaultPaddingThicknessLeft_}, Path=Value}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="checkbox-radio"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource checkbox-default}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
