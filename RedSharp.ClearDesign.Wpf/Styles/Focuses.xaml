<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="FocusDefault"
           TargetType="{x:Type Control}">
        <Style.Setters>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushFocusedBorder}"/>
            <Setter Property="BorderThickness"
                    Value="{DynamicResource SizeFocusedBorderAll}"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="utils:Control.CornerRadius"
                    Value="{DynamicResource SizeDefaultRadiusAll}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <controls:AdornedPlaceholder CornerRadius="{TemplateBinding utils:Control.CornerRadius}">
                            <controls:RoundBorder UseLayoutRounding="False"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=controls:AdornedPlaceholder}, Path=ActualCornerRadius}"
                                                  UseOuterCornerRadius="True"/>
                        </controls:AdornedPlaceholder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
    
    <Style x:Key="FocusDefaultOutstanding"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource FocusDefault}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <controls:AdornedPlaceholder CornerRadius="{TemplateBinding utils:Control.CornerRadius}">
                            <controls:RoundBorder UseLayoutRounding="False"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  Margin="{DynamicResource SizeFocusedMarginAll}"
                                                  CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=controls:AdornedPlaceholder}, Path=ActualCornerRadius}"
                                                  UseOuterCornerRadius="False"/>
                        </controls:AdornedPlaceholder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="FocusRectangle"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource FocusDefault}">
        <Style.Setters>
            <Setter Property="utils:Control.CornerRadius"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="FocusRectangleOutstanding"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource FocusDefaultOutstanding}">
        <Style.Setters>
            <Setter Property="utils:Control.CornerRadius"
                    Value="0"/>
        </Style.Setters>
    </Style>

</ResourceDictionary>