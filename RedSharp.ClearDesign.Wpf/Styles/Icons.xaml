<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="icon-min"
           TargetType="Path">
        <Style.Setters>
            <Setter Property="Width" 
                    Value="12"/>

            <Setter Property="Height" 
                    Value="12"/>

            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>

            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="icon-default"
           TargetType="Path"
           BasedOn="{StaticResource icon-min}">
        <Style.Setters>
            <Setter Property="Width" 
                    Value="16"/>

            <Setter Property="Height" 
                    Value="16"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="icon-medium"
           TargetType="Path"
           BasedOn="{StaticResource icon-min}">
        <Style.Setters>
            <Setter Property="Width" 
                    Value="24"/>

            <Setter Property="Height" 
                    Value="24"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="icon-big"
           TargetType="Path"
           BasedOn="{StaticResource icon-min}">
        <Style.Setters>
            <Setter Property="Width" 
                    Value="30"/>

            <Setter Property="Height" 
                    Value="30"/>
        </Style.Setters>
    </Style>

