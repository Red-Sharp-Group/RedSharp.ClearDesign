<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="icon-default"
           TargetType="Path">
        <Style.Setters>
            <Setter Property="Width" 
                    Value="16"/>

            <Setter Property="Height" 
                    Value="16"/>

            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>

            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
        </Style.Setters>
    </Style>

    <Style x:Key="icon-min"
           TargetType="Path">
        <Style.Setters>
            <Setter Property="Width" 
                    Value="12"/>

            <Setter Property="Height" 
                    Value="12"/>

            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>

            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
        </Style.Setters>
    </Style>
    
    <PathGeometry x:Key="S_CloseIconGeometry_" 
                Figures="M3.5 3.5L12.5 12.5M12.5 3.5L3.5 12.5" />

    <PathGeometry x:Key="S_MaximizeIconGeometry_" 
                Figures="M12.5 3.5H3.5V12.5H12.5V3.5Z" />

    <GeometryGroup x:Key="S_RestoreIconGeometry_" >
        <PathGeometry Figures="M11.5 5.5H3.5V13.5H11.5V5.5Z" />
        <PathGeometry Figures="M5.5 5.5V3.5H13.5V11.5H11.5" />
    </GeometryGroup>

    <PathGeometry x:Key="S_MinimizeIconGeometry_"
                Figures="M3 8.5H13" />
    
</ResourceDictionary>