<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        
        <ResourceDictionary Source="ScrollViewers.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ListBoxItemDefault"
           TargetType="{x:Type ListBoxItem}">
        <Style.Setters>
            <Setter Property="MinHeight"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>
            <Setter Property="Padding"
                    Value="{DynamicResource SizeDefaultPaddingLeftRight}"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushDefaultForeground}"/>
            
            <Setter Property="FontFamily"
                    Value="{DynamicResource FontText}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeText}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightText}"/>

            <Setter Property="utils:Highlight.Fill"
                    Value="{DynamicResource BrushHighlightBackground}"/>
            <Setter Property="utils:Highlight.Opacity"
                    Value="0.0"/>

            <Setter Property="utils:Selection.Fill"
                    Value="{DynamicResource BrushSelectedBackground}"/>
            <Setter Property="utils:Selection.Opacity"
                    Value="0.0"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource FocusDefault}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid MinHeight="{TemplateBinding MinHeight}">

                            <!--BACKGROUND-->
                            <Border Background="{TemplateBinding Background}"
                                    Opacity="0.20"/>

                            <!--HIGHLIGHT-->
                            <Border Background="{TemplateBinding utils:Highlight.Fill}"
                                    Opacity="{TemplateBinding utils:Highlight.Opacity}"/>

                            <!--SELECTION-->
                            <Border Background="{TemplateBinding utils:Selection.Fill}"
                                    Opacity="{TemplateBinding utils:Selection.Opacity}"/>

                            <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="AnimationHighlightHoveredEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="AnimationHighlightHoveredExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="AnimationHighlightPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="AnimationHighlightPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="utils:Selection.Opacity"
                        Value="0.5"/>
            </Trigger>

            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" 
                        Value="{DynamicResource BrushPanelsBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListBoxDefault"
           TargetType="{x:Type ListBox}">
        <Style.Setters>
            <Setter Property="AlternationCount"
                    Value="2"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource FocusDefault}"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource ListBoxItemDefault}"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer Style="{StaticResource ScrollViewerDefault}" 
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      Focusable="false">
                            <StackPanel IsItemsHost="True"
                                        Margin="0,0,0,5"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style TargetType="{x:Type ListBox}"
           BasedOn="{StaticResource ListBoxDefault}"/>

</ResourceDictionary>