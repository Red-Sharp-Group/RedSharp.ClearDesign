<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="repeatbutton-secondary" 
           TargetType="{x:Type RepeatButton}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultWidth_}"/>
            <Setter Property="Height"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="{utils:BindingResource B_DefaultPaddingThicknessLeftRight_}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource S_SecondaryColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{utils:BindingResource B_DefaultBorderThicknessFull_}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource D_DefaultCommonFontFamily_}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource D_DefaultCommonFontSize_}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource D_DefaultCommonFontWeight_}"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding}"/>

            <Setter Property="extra:AccentsExtra.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="extra:AccentsExtra.Opacity"
                    Value="0.0"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid>
                            <!--BACKGROUND-->
                            <Border UseLayoutRounding="True" 
                                    Background="{TemplateBinding BorderBrush}">
                                <Border UseLayoutRounding="False" 
                                        Background="{TemplateBinding Background}"
                                        Margin="{TemplateBinding BorderThickness}"/>
                            </Border>
                            
                            <!--ACCENT-->
                            <Border UseLayoutRounding="True" 
                                    Background="{TemplateBinding extra:AccentsExtra.Color}"
                                    Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>

                            <ContentControl UseLayoutRounding="False"
                                            Focusable="False"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="OpacityMask"
                        Value="{StaticResource S_DisabledStateMaskColorBrush_}"/>
                <Setter Property="Background"
                        Value="{StaticResource S_DefaultDisabledAccentColorBrush_}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="repeatbutton-secondary-icon"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="repeatbutton-primary"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-secondary}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{StaticResource S_PrimaryColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_PrimaryFontColorBrush_}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource S_PrimaryBorderColorBrush_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="repeatbutton-primary-icon"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="repeatbutton-menu"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{x:Static system:Double.NaN}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-default}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="repeatbutton-menu-icon"
           TargetType="{x:Type RepeatButton}"
           BasedOn="{StaticResource repeatbutton-menu}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>
</ResourceDictionary>