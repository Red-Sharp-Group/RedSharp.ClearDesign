<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="button-secondary" 
           TargetType="{x:Type Button}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultWidth_}"/>
            <Setter Property="Height"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="{Binding Source={StaticResource S_DefaultPaddingThicknessLeftRight_}, Path=Value}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource S_SecondaryColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{Binding Source={StaticResource S_DefaultBorderThicknessFull_}, Path=Value}"/>
            
            <Setter Property="FontFamily"
                    Value="{DynamicResource D_DefaultCommonFontFamily_}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource D_DefaultCommonFontSize_}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource D_DefaultCommonFontWeight_}"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding}"/>

            <Setter Property="helpers:AccentHelper.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="helpers:AccentHelper.Opacity"
                    Value="0.0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border UseLayoutRounding="True"
                                    Background="{TemplateBinding BorderBrush}">
                                <Border UseLayoutRounding="False"
                                        Background="{TemplateBinding Background}"
                                        Margin="{TemplateBinding BorderThickness}">
                                </Border>
                            </Border>
                            
                            <Border UseLayoutRounding="True"
                                    Background="{TemplateBinding helpers:AccentHelper.Color}"
                                    Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>
                            
                            <ContentControl UseLayoutRounding="False" 
                                            Focusable="False"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="button-secondary-icon"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource button-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="button-primary"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource button-secondary}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{StaticResource S_PrimaryColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_PrimaryFontColorBrush_}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource S_PrimaryBorderColorBrush_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="button-primary-icon"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource button-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="button-menu"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource button-secondary}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{x:Static system:Double.NaN}"/>

            <Setter Property="Background"
                    Value="Transparent"/>
            
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            
            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-default}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="button-menu-icon"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource button-menu}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>    
</ResourceDictionary>