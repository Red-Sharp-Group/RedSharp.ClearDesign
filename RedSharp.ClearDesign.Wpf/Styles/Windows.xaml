<ResourceDictionary x:Class="RedSharp.ClearDesign.Wpf.Styles.Windows"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>

        <ResourceDictionary Source="Buttons.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="WindowDefault" TargetType="{x:Type Window}">
        <Style.Setters>
            <Setter Property="Background" 
                    Value="{DynamicResource BrushDefaultBackground}"/>

            <Setter Property="BorderBrush" 
                    Value="{DynamicResource BrushElementsBorder}"/>

            <!--I do not recommend to set it to Sizes definition, it looks weird-->
            <Setter Property="BorderThickness" 
                    Value="1"/>

            <Setter Property="WindowStyle"
                    Value="SingleBorderWindow"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="UseLayoutRounding"
                    Value="True"/>

            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0"
                                  ResizeBorderThickness="5"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Window}">
                        <AdornerDecorator>
                            <Border Background="{TemplateBinding Background}">
                                <Border BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Setters>
                                                <Setter Property="Padding"
                                                        Value="0"/>
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}"
                                                            Value="Maximized">
                                                    <Setter Property="Padding"
                                                            Value="6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Rectangle Grid.Row="0"
                                                   Grid.Column="0"
                                                   Fill="Transparent"
                                                   VerticalAlignment="Stretch"
                                                   WindowChrome.IsHitTestVisibleInChrome="True"
                                                   MouseDown="TitleMouseDown"
                                                   MouseMove="TitleMouseMove"
                                                   MouseUp="TitleMouseUp"
                                                   Margin="0,5,0,0"/>

                                        <ContentPresenter Grid.Row="0"
                                                          Grid.Column="0"
                                                          Grid.RowSpan="2" 
                                                          Content="{TemplateBinding Content}"/>

                                        <Grid Grid.Row="0"
                                              Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource ButtonMenu}"
                                                    Width="46"
                                                    Click="MinimizeButtonClick"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    utils:Control.CornerRadius="0"
                                                    Focusable="False">
                                                <Image Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Source="{StaticResource DrawingImageMinimize}"/>
                                            </Button>

                                            <Button Grid.Column="2"
                                                    Width="46"
                                                    Click="MaximizeButtonClick"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    utils:Control.CornerRadius="0"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" 
                                                           BasedOn="{StaticResource ButtonMenu}">
                                                        <Style.Setters>
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <Image Width="16"
                                                                           Height="16"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Source="{StaticResource DrawingImageMaximize}"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style.Setters>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}"
                                                                     Value="Maximized">
                                                                <Setter Property="Content">
                                                                    <Setter.Value>
                                                                        <Image Width="16"
                                                                               Height="16"
                                                                               VerticalAlignment="Center"
                                                                               HorizontalAlignment="Center"
                                                                               Source="{StaticResource DrawingImageRestore}"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource ButtonMenu}"
                                                    Width="46"
                                                    Click="CloseButtonClick"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    utils:Control.CornerRadius="0"
                                                    Focusable="False">
                                                <Image Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Source="{StaticResource DrawingImageClose}"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>
                        </AdornerDecorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
</ResourceDictionary>