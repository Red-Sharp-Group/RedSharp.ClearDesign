<ResourceDictionary x:Class="RedSharp.ClearDesign.Styles.Windows"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="Buttons.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Binding x:Key="Internal_B_WindowStateBinding"
             RelativeSource="{RelativeSource AncestorType=Window}"
             Path="WindowState"/>

    <Style x:Key="window-default" 
           TargetType="{x:Type Window}">
        <Style.Setters>
            <Setter Property="Background" 
                    Value="{StaticResource S_BackgroundColorBrush_}"/>

            <Setter Property="BorderBrush" 
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>

            <Setter Property="BorderThickness" 
                    Value="{DynamicResource D_DefaultBorderThicknessFull_}"/>

            <Setter Property="extra:WindowsExtra.MinimizeVisibility" 
                    Value="Visible"/>
            <Setter Property="extra:WindowsExtra.MaximizeVisibility" 
                    Value="Visible"/>
            <Setter Property="extra:WindowsExtra.CloseVisibility" 
                    Value="Visible"/>

            <Setter Property="WindowStyle"
                    Value="SingleBorderWindow"/>

            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0"
                                  ResizeBorderThickness="5"/>
                </Setter.Value>
            </Setter>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Window}">
                        <AdornerDecorator>
                            <Border Background="{TemplateBinding Background}">
                                <Border BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Setters>
                                                <Setter Property="Padding"
                                                        Value="0"/>
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{utils:BindingResource Internal_B_WindowStateBinding}"
                                                             Value="Maximized">
                                                    <Setter Property="Padding"
                                                            Value="7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Rectangle Grid.Row="0"
                                                   Grid.Column="0"
                                                   Fill="Transparent"
                                                   VerticalAlignment="Stretch"
                                                   WindowChrome.IsHitTestVisibleInChrome="True"
                                                   MouseDown="TitleMouseDown"
                                                   MouseMove="TitleMouseMove"
                                                   MouseUp="TitleMouseUp"
                                                   Margin="0,5,0,0"/>

                                        <ContentPresenter Grid.Row="0"
                                                          Grid.Column="0"
                                                          Grid.RowSpan="2" 
                                                          ContentSource="{TemplateBinding Content}"/>

                                        <Grid Grid.Row="0"
                                              Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource button-menu}"
                                                    Width="46"
                                                    Click="MinimizeButtonClick"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    Visibility="{TemplateBinding extra:WindowsExtra.MinimizeVisibility}">
                                                <Path Style="{StaticResource icon-default}" 
                                                      Stroke="{StaticResource S_CommonFontColorBrush_}"
                                                      StrokeThickness="1"
                                                      Data="{StaticResource S_MinimizeIconGeometry_}"/>
                                            </Button>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource button-menu}"
                                                    Width="46"
                                                    Click="MaximizeButtonClick"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    Visibility="{TemplateBinding extra:WindowsExtra.MaximizeVisibility}">
                                                <Grid>
                                                    <Path Stroke="{StaticResource S_CommonFontColorBrush_}"
                                                          StrokeThickness="1"
                                                          Data="{StaticResource S_MaximizeIconGeometry_}">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}"
                                                                   BasedOn="{StaticResource icon-default}">
                                                                <Style.Setters>
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </Style.Setters>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{utils:BindingResource Internal_B_WindowStateBinding}"
                                                                                 Value="Maximized">
                                                                        <Setter Property="Visibility"
                                                                                Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>

                                                    <Path Stroke="{StaticResource S_CommonFontColorBrush_}"
                                                          StrokeThickness="1"
                                                          Data="{StaticResource S_RestoreIconGeometry_}">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}"
                                                                   BasedOn="{StaticResource icon-default}">
                                                                <Style.Setters>
                                                                    <Setter Property="Visibility"
                                                                            Value="Hidden"/>
                                                                </Style.Setters>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{utils:BindingResource Internal_B_WindowStateBinding}"
                                                                                 Value="Maximized">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource button-menu}"
                                                    Width="46"
                                                    Click="CloseButtonClick"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    Visibility="{TemplateBinding extra:WindowsExtra.MaximizeVisibility}">
                                                <Path Style="{StaticResource icon-default}" 
                                                      Stroke="{StaticResource S_CommonFontColorBrush_}"
                                                      StrokeThickness="1"
                                                      Data="{StaticResource S_CloseIconGeometry_}"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>
                        </AdornerDecorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
</ResourceDictionary>