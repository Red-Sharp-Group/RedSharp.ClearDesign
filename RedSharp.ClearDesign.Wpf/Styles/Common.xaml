<ResourceDictionary x:Class="RedSharp.ClearDesign.Styles.Common"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BeginStoryboard x:Key="S_AccentHoverEnterAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.15" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"/>
        </Storyboard>
    </BeginStoryboard>

    <BeginStoryboard x:Key="S_AccentHoverExitAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.0" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"
                             FillBehavior="Stop"/>
        </Storyboard>
    </BeginStoryboard>

    <BeginStoryboard x:Key="S_AccentPressedEnterAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.25" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"/>
        </Storyboard>
    </BeginStoryboard>

    <BeginStoryboard x:Key="S_AccentPressedExitAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.15" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"
                             FillBehavior="Stop"/>
        </Storyboard>
    </BeginStoryboard>

    <Style x:Key="focus-default"
           TargetType="{x:Type Control}">
        <Style.Setters>
            <Setter Property="BorderBrush"
                    Value="{StaticResource S_FocusBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{DynamicResource D_DefaultFocusThicknessFull_}"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="False"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="focus-outstanding"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource focus-default}">
        <Style.Setters>
            <Setter Property="Margin"
                    Value="{DynamicResource D_OutstandingFocusThicknessFull_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="focus-outstanding-checkbox"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource focus-default}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="{DynamicResource D_DefaultToggleHeight_}"
                                Height="{DynamicResource D_DefaultToggleHeight_}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Margin="{DynamicResource D_OutstandingFocusThicknessFull_}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="focus-outstanding-switch"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource focus-default}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="{DynamicResource D_SwitchToggleWidth_}"
                                Height="{DynamicResource D_RoundToggleHeight_}">
                            <Border SizeChanged="OnBorderSizeChanged"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Margin="{DynamicResource D_OutstandingFocusThicknessFull_}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="focus-outstanding-radio"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource focus-default}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="{DynamicResource D_RoundToggleHeight_}"
                                Height="{DynamicResource D_RoundToggleHeight_}">
                            <Border SizeChanged="OnBorderSizeChanged"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Margin="{DynamicResource D_OutstandingFocusThicknessFull_}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="rectange-separator-vertical"
           TargetType="{x:Type Rectangle}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="Fill"
                    Value="{StaticResource S_Dark5ColorBrush_}"/>

            <Setter Property="Margin"
                    Value="{DynamicResource D_DefaultMarginThicknessTopBottom_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="rectange-separator-horizontal"
           TargetType="{x:Type Rectangle}">
        <Style.Setters>
            <Setter Property="Height"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="Fill"
                    Value="{StaticResource S_Dark5ColorBrush_}"/>

            <Setter Property="Margin"
                    Value="{DynamicResource D_DefaultMarginThicknessLeftRight_}"/>
        </Style.Setters>
    </Style>
</ResourceDictionary>