<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BeginStoryboard x:Key="S_AccentHoverEnterAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.15" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"/>
        </Storyboard>
    </BeginStoryboard>

    <BeginStoryboard x:Key="S_AccentHoverExitAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.0" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"
                             FillBehavior="Stop"/>
        </Storyboard>
    </BeginStoryboard>

    <BeginStoryboard x:Key="S_AccentPressedEnterAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.25" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"/>
        </Storyboard>
    </BeginStoryboard>

    <BeginStoryboard x:Key="S_AccentPressedExitAnimation"
                     x:Shared="false">
        <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(extra:AccentsExtra.Opacity)"
                             To="0.15" 
                             Duration="0:0:0.075" 
                             AutoReverse="False"
                             FillBehavior="Stop"/>
        </Storyboard>
    </BeginStoryboard>

    <Style x:Key="focus-default"
           TargetType="{x:Type Control}">
        <Style.Setters>
            <Setter Property="BorderBrush"
                    Value="{StaticResource S_FocusBorderColorBrush_}"/>

            <Setter Property="BorderThickness"
                    Value="{utils:BindingResource B_DefaultFocusThicknessFull_}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="focus-outstanding"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource focus-default}">
        <Style.Setters>
            <Setter Property="Margin"
                    Value="{utils:BindingResource B_OutstandingFocus_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="rectange-separator-vertical"
           TargetType="{x:Type Rectangle}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="Fill"
                    Value="{StaticResource S_Dark5ColorBrush_}"/>

            <Setter Property="Margin"
                    Value="{utils:BindingResource B_DefaultMarginThicknessTopBottom_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="rectange-separator-horizontal"
           TargetType="{x:Type Rectangle}">
        <Style.Setters>
            <Setter Property="Height"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="Fill"
                    Value="{StaticResource S_Dark5ColorBrush_}"/>

            <Setter Property="Margin"
                    Value="{utils:BindingResource B_DefaultMarginThicknessLeftRight_}"/>
        </Style.Setters>
    </Style>
</ResourceDictionary>