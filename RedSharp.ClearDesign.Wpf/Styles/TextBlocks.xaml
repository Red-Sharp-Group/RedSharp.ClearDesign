<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="TextBlockDefault" 
           TargetType="TextBlock">
        <Style.Setters>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushDefaultForeground}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource FontText}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeText}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightText}"/>
            
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
            
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsEnabled" 
                     Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource BrushDisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockDefault}"/>

    <Style x:Key="__TextBlockEmptyStyle" 
           TargetType="{x:Type TextBlock}">
        <Style.Setters>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style.Setters>
    </Style>

    <DataTemplate DataType="{x:Type system:String}">
        <TextBlock Text="{Binding}" Style="{StaticResource __TextBlockEmptyStyle}"/>
    </DataTemplate>

    <Style x:Key="TextBlockCode" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockDefault}">
        <Style.Setters>
            <Setter Property="FontFamily"
                    Value="{DynamicResource FontCode}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeCode}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightCode}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="TextBlockQuote" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockDefault}">
        <Style.Setters>
            <Setter Property="FontFamily"
                    Value="{DynamicResource FontQuote}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeQuote}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightQuote}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="TextBlockSubtitle" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockDefault}">
        <Style.Setters>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushSubtitleForeground}"/>
        </Style.Setters>
    </Style>

    
    <Style x:Key="TextBlockHeader1" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockDefault}">
        <Style.Setters>
            <Setter Property="FontFamily"
                    Value="{DynamicResource FontHeader}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeHeader1}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightHeader1}"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="TextBlockHeader2" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockHeader1}">
        <Style.Setters>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeHeader2}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightHeader2}"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="TextBlockHeader3" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockHeader1}">
        <Style.Setters>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeHeader3}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightHeader3}"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="TextBlockHeader4" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockHeader1}">
        <Style.Setters>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeHeader4}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightHeader4}"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="TextBlockHeader5" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockHeader1}">
        <Style.Setters>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeHeader5}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightHeader5}"/>
        </Style.Setters>
    </Style>
    
    <Style x:Key="TextBlockHeader6" 
           TargetType="TextBlock"
           BasedOn="{StaticResource TextBlockHeader1}">
        <Style.Setters>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeHeader6}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightHeader6}"/>
        </Style.Setters>
    </Style>
</ResourceDictionary>