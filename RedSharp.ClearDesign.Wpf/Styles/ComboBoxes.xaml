<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/ScrollViewers.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="combobox-default"
           TargetType="ComboBox">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultWidth_}"/>
            <Setter Property="Height"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="{DynamicResource D_DefaultPaddingThicknessLeftRight_}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource S_FieldsColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{DynamicResource D_DefaultBorderThicknessFull_}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource D_DefaultCommonFontFamily_}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource D_DefaultCommonFontSize_}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource D_DefaultCommonFontWeight_}"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding}"/>

            <Setter Property="extra:AccentsExtra.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="extra:AccentsExtra.Opacity"
                    Value="0.0"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid>
                            <!--BORDER-->
                            <Border UseLayoutRounding="True" 
                                    Background="{TemplateBinding BorderBrush}"/>

                            <!--ACCENT-->
                            <Border UseLayoutRounding="True" 
                                    Background="{TemplateBinding extra:AccentsExtra.Color}"
                                    Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>

                            <!--BACKGROUND-->
                            <Border UseLayoutRounding="False" 
                                    Background="{TemplateBinding Background}"
                                    Margin="{TemplateBinding BorderThickness}"/>

                            <!--TEXT HOLDER-->
                            <TextBlock Text="{TemplateBinding Text}"
                                       Visibility="{TemplateBinding extra:TextBoxesExtra.WrapperVisibility}"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="1.5,0"
                                       Width="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>