<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">
    
    <Style x:Key="ProgressBarDefault"
           TargetType="{x:Type ProgressBar}">
        <Style.Setters>
            <Setter Property="Height"
                    Value="10"/>
            
            <Setter Property="utils:Control.CornerRadius"
                    Value="1000"/>

            <Setter Property="Background"
                    Value="{DynamicResource BrushPanelsBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushPrimaryBackground}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid Height="{TemplateBinding Height}">

                            <controls:LayeredBorder x:Name="PART_Track" 
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                    Background="{TemplateBinding Background}"/>

                            <Border x:Name="PART_Indicator" 
                                    ClipToBounds="True"
                                    HorizontalAlignment="Left">
                                <controls:LayeredBorder CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                        Background="{TemplateBinding Foreground}"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding ElementName=PART_Track, Path=ActualWidth}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>

        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource ProgressBarDefault}"/>

    <Style x:Key="ProgressBarMini"
           TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource ProgressBarDefault}">
        <Style.Setters>
            <Setter Property="Height"
                    Value="6"/>
        </Style.Setters>
    </Style>
</ResourceDictionary>