<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/ScrollBars.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="scrollviewer-default"
           TargetType="{x:Type ScrollViewer}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <AdornerDecorator Grid.Column="0"
                                              Grid.Row="0"
                                              Grid.ColumnSpan="3"
                                              Grid.RowSpan="3">
                                <ScrollContentPresenter Name="PART_ScrollContentPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Local"
                                                        Content="{TemplateBinding ContentControl.Content}"
                                                        ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                        Margin="{TemplateBinding Padding}"/>
                            </AdornerDecorator>

                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Style="{StaticResource scrollbar-vertical-resizable-full}"
                                       Margin="2"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}"
                                       Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}"
                                       
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       Focusable="False"/>

                            <ScrollBar Name="PART_HorizontalScrollBar"
                                       Style="{StaticResource scrollbar-horizontal-resizable-full}"
                                       Margin="2"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}"
                                       Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}"
                                       
                                       Grid.Column="1"
                                       Grid.Row="2"
                                       Focusable="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="scrollviewer-min"
           TargetType="{x:Type ScrollViewer}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <AdornerDecorator Grid.Column="0"
                                              Grid.Row="0"
                                              Grid.ColumnSpan="3"
                                              Grid.RowSpan="3">
                                <ScrollContentPresenter Name="PART_ScrollContentPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Local"
                                                        Content="{TemplateBinding ContentControl.Content}"
                                                        ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                        Margin="{TemplateBinding Padding}"/>
                            </AdornerDecorator>

                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Style="{StaticResource scrollbar-vertical-min}"
                                       Margin="2"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}"
                                       Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}"
                                       
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       Focusable="False"/>

                            <ScrollBar Name="PART_HorizontalScrollBar"
                                       Style="{StaticResource scrollbar-horizontal-min}"
                                       Margin="2"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}"
                                       Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}"
                                       
                                       Grid.Column="1"
                                       Grid.Row="2"
                                       Focusable="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
</ResourceDictionary>