<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ScrollBars.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ScrollViewerDefault"
           TargetType="{x:Type ScrollViewer}">
        <Style.Setters>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <AdornerDecorator Grid.Column="0"
                                              Grid.Row="0"
                                              Grid.ColumnSpan="2"
                                              Grid.RowSpan="2"
                                              Focusable="False">
                                <ScrollContentPresenter Name="PART_ScrollContentPresenter" 
                                                        Focusable="False"
                                                        KeyboardNavigation.DirectionalNavigation="Local"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Margin="{TemplateBinding Padding}"/>
                            </AdornerDecorator>

                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ScrollBarVerticalFull}"
                                       Margin="2,10"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}"
                                       Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}"
                                       
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       Grid.RowSpan="2"
                                       Focusable="False"/>

                            <ScrollBar Name="PART_HorizontalScrollBar"
                                       Style="{StaticResource ScrollBarHorizontalFull}"
                                       Margin="10,2"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}"
                                       Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}"
                                       
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Focusable="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}"
           BasedOn="{StaticResource ScrollViewerDefault}"/>

    <Style x:Key="ScrollViewerMini"
           TargetType="{x:Type ScrollViewer}">
        <Style.Setters>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <AdornerDecorator Grid.Column="0"
                                              Grid.Row="0"
                                              Grid.ColumnSpan="2"
                                              Grid.RowSpan="2">
                                <ScrollContentPresenter Name="PART_ScrollContentPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Local"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Margin="{TemplateBinding Padding}"/>
                            </AdornerDecorator>

                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ScrollBarVerticalMinimal}"
                                       Margin="2,14"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}"
                                       Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}"
                                       
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       Grid.RowSpan="2"
                                       Focusable="False"/>

                            <ScrollBar Name="PART_HorizontalScrollBar"
                                       Style="{StaticResource ScrollBarHorizontalMinimal}"
                                       Margin="14,2"
                                       
                                       Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}"
                                       Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}"
                                       ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}"
                                       
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Focusable="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="__ScrollViewerHidden"
           TargetType="{x:Type ScrollViewer}">
        <Style.Setters>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Hidden"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Hidden"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <ScrollContentPresenter Name="PART_ScrollContentPresenter" 
                                                KeyboardNavigation.DirectionalNavigation="Local"
                                                Content="{TemplateBinding Content}"
                                                Margin="{TemplateBinding Padding}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="__ScrollViewerHiddenNoPadding"           
           TargetType="{x:Type ScrollViewer}"
           BasedOn="{StaticResource __ScrollViewerHidden}">
        <Style.Setters>
            <!--The text box control will push padding even if don't want to, so the best way to remove it off is to change the template-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <ScrollContentPresenter Name="PART_ScrollContentPresenter" 
                                                KeyboardNavigation.DirectionalNavigation="Local"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
</ResourceDictionary>