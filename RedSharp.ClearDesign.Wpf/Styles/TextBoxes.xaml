<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        
        <ResourceDictionary Source="Focuses.xaml"/>
        <ResourceDictionary Source="Animations.xaml"/>
        <ResourceDictionary Source="Validations.xaml"/>
        <ResourceDictionary Source="ScrollViewers.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="TextBoxDefault"
           TargetType="{x:Type TextBox}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="{DynamicResource SizeDefaultMinWidth}"/>
            <Setter Property="MinHeight"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>

            <Setter Property="Padding"
                    Value="{DynamicResource SizeDefaultPaddingLeftRight}"/>

            <Setter Property="BorderThickness"
                    Value="{DynamicResource SizeDefaultBorderAll}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource BrushFieldsBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushElementsBorder}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushDefaultForeground}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource FontText}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeText}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightText}"/>

            <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusDefaultOutstanding}"/>

            <Setter Property="utils:Control.CornerRadius"
                    Value="{DynamicResource SizeDefaultRadiusAll}"/>

            <Setter Property="utils:Highlight.Fill"
                    Value="{DynamicResource BrushHighlightBackground}"/>
            <Setter Property="utils:Highlight.Opacity"
                    Value="0.0"/>

            <Setter Property="utils:Selection.Fill"
                    Value="{DynamicResource BrushSelectedBorder}"/>
            <Setter Property="utils:Selection.Opacity"
                    Value="0.0"/>

            <Setter Property="utils:TextBox.Placeholder" 
                    Value=""/>

            <Setter Property="SelectionBrush"
                    Value="{DynamicResource BrushSelectedBorder}"/>
            <Setter Property="SelectionOpacity"
                    Value="0.5"/>

            <Setter Property="Validation.ErrorTemplate"
                    Value="{StaticResource ValidationDefaultOutstanding}"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid UseLayoutRounding="False"
                              Background="Transparent"
                              Cursor="IBeam">
                            <!--BACKGROUND-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>

                            <!--TEXT PRESENTER-->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Visibility="Hidden"
                                          Style="{StaticResource __ScrollViewerHidden}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <!--TEXT HOLDER-->
                            <TextBlock x:Name="PART_ContentHolder"
                                       Text="{TemplateBinding Text}"
                                       Visibility="Visible"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="1.75,0"
                                       MaxWidth="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>

                            <!--PLACE HOLDER-->
                            <TextBlock x:Name="PART_PlaceHolder"
                                       Text="{TemplateBinding utils:TextBox.Placeholder}"
                                       Visibility="Hidden"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="1.5,0"
                                       MaxWidth="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Opacity="0.5"/>

                            <!--BORDER-->
                            <controls:RoundBorder UseLayoutRounding="False" 
                                                  BorderBrush="{TemplateBinding utils:Highlight.Fill}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                  Opacity="{TemplateBinding utils:Highlight.Opacity}"/>

                            <!--SELECTION BORDER-->
                            <controls:RoundBorder UseLayoutRounding="False" 
                                                  BorderBrush="{TemplateBinding utils:Selection.Fill}"
                                                  BorderThickness="{DynamicResource SizeSelectedBorderAll}"
                                                  CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                  Margin="{DynamicResource SizeSelectedMarginAll}"
                                                  Opacity="{TemplateBinding utils:Selection.Opacity}"
                                                  UseOuterCornerRadius="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseCaptured" Value="True">
                                <Setter TargetName="PART_ContentHost" 
                                        Property="Visibility" 
                                        Value="Visible"/>
                                <Setter TargetName="PART_ContentHolder" 
                                        Property="Visibility" 
                                        Value="Hidden"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text, Converter={x:Static utils:Converters.IsNullOrEmpty}}"
                                         Value="True">
                                <Setter TargetName="PART_PlaceHolder" 
                                        Property="Visibility" 
                                        Value="Visible"/>
                            </DataTrigger>
                            
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PART_ContentHost" 
                                        Property="Visibility" 
                                        Value="Visible"/>
                                <Setter TargetName="PART_ContentHolder" 
                                        Property="Visibility" 
                                        Value="Hidden"/>
                                <Setter TargetName="PART_PlaceHolder" 
                                        Property="Visibility" 
                                        Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsFocused" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionSelected"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionSelected"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity"
                        Value="0.40"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                
                <Setter Property="Background"
                        Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource BrushDisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}" 
           BasedOn="{StaticResource TextBoxDefault}"/>

    <Style x:Key="TextBoxHidden"
           BasedOn="{StaticResource TextBoxDefault}"
           TargetType="{x:Type TextBox}">
        <Style.Setters>           
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
        </Style.Setters>
        
        <Style.Triggers>

            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background"
                    Value="{DynamicResource BrushFieldsBackground}"/>
                <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushElementsBorder}"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"
                        Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource BrushDisabledBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBoxExtended"
           BasedOn="{StaticResource TextBoxDefault}"
           TargetType="{x:Type TextBox}">
        <Style.Setters>
            <Setter Property="Padding"
                    Value="{DynamicResource SizeDefaultPaddingLeft}"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid UseLayoutRounding="False"
                              Background="Transparent">
                            <!--BACKGROUND-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  UseLayoutRounding="False"
                                                  Focusable="False"
                                                  VerticalAlignment="Stretch"
                                                  Content="{TemplateBinding utils:DockContent.Left}"/>

                                <!--TEXT PRESENTER-->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              Visibility="Hidden"
                                              Style="{StaticResource __ScrollViewerHiddenNoPadding}"                                              
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                <!--TEXT HOLDER-->
                                <TextBlock x:Name="PART_ContentHolder"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Text}"
                                           Visibility="Visible"
                                           Margin="1.75,0"
                                           MaxWidth="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Cursor="IBeam"/>

                                <!--PLACE HOLDER-->
                                <TextBlock x:Name="PART_PlaceHolder"
                                           Grid.Column="1"
                                           Text="{TemplateBinding utils:TextBox.Placeholder}"
                                           Visibility="Hidden"
                                           Margin="1.5,0"
                                           MaxWidth="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Opacity="0.5"
                                           Cursor="IBeam"/>

                                <ContentPresenter Grid.Column="2"
                                                  UseLayoutRounding="False"
                                                  Focusable="False"
                                                  VerticalAlignment="Stretch"
                                                  Content="{TemplateBinding utils:DockContent.Right}"/>
                            </Grid>

                            <!--BORDER-->
                            <controls:RoundBorder UseLayoutRounding="False" 
                                                  BorderBrush="{TemplateBinding utils:Highlight.Fill}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                  Opacity="{TemplateBinding utils:Highlight.Opacity}"/>

                            <!--SELECTION BORDER-->
                            <controls:RoundBorder UseLayoutRounding="False" 
                                                  BorderBrush="{TemplateBinding utils:Selection.Fill}"
                                                  BorderThickness="{DynamicResource SizeSelectedBorderAll}"
                                                  CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                  Margin="{DynamicResource SizeSelectedMarginAll}"
                                                  Opacity="{TemplateBinding utils:Selection.Opacity}"
                                                  UseOuterCornerRadius="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseCaptured" Value="True">
                                <Setter TargetName="PART_ContentHost" 
                                        Property="Visibility" 
                                        Value="Visible"/>
                                <Setter TargetName="PART_ContentHolder" 
                                        Property="Visibility" 
                                        Value="Hidden"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text, Converter={StaticResource ConverterIsNullOrEmpty}}"
                                         Value="True">
                                <Setter TargetName="PART_PlaceHolder" 
                                        Property="Visibility" 
                                        Value="Visible"/>
                            </DataTrigger>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PART_ContentHost" 
                                        Property="Visibility" 
                                        Value="Visible"/>
                                <Setter TargetName="PART_ContentHolder" 
                                        Property="Visibility" 
                                        Value="Hidden"/>
                                <Setter TargetName="PART_PlaceHolder" 
                                        Property="Visibility" 
                                        Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="TextBoxExtendedHidden"
           BasedOn="{StaticResource TextBoxExtended}"
           TargetType="{x:Type TextBox}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
        </Style.Setters>

        <Style.Triggers>

            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background"
                    Value="{DynamicResource BrushFieldsBackground}"/>
                <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushElementsBorder}"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"
                        Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource BrushDisabledBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>