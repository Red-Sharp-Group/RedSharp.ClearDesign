<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/ScrollViewers.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="textbox-default"
           TargetType="{x:Type TextBox}">
        <Style.Setters>
            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultWidth_}"/>
            <Setter Property="Height"
                    Value="{DynamicResource D_DefaultHeight_}"/>
            <Setter Property="Padding"
                    Value="{DynamicResource D_DefaultPaddingThicknessLeftRight_}"/>
            
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{StaticResource S_FieldsColorBrush_}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{DynamicResource D_DefaultBorderThicknessFull_}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource D_DefaultCommonFontFamily_}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource D_DefaultCommonFontSize_}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource D_DefaultCommonFontWeight_}"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding}"/>

            <Setter Property="extra:AccentsExtra.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="extra:AccentsExtra.Opacity"
                    Value="0.0"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>
            
            <Setter Property="extra:TextBoxesExtra.PresenterVisibility" 
                    Value="Hidden"/>
            <Setter Property="extra:TextBoxesExtra.WrapperVisibility" 
                    Value="Visible"/>
            <Setter Property="extra:TextBoxesExtra.PlaceholderVisibility" 
                    Value="Hidden"/>
            
            <Setter Property="extra:TextBoxesExtra.Placeholder" 
                    Value=""/>

            <Setter Property="SelectionBrush"
                    Value="{StaticResource S_PrimaryColorBrush_}"/>
            <Setter Property="SelectionOpacity"
                    Value="0.5"/>

            <Setter Property="Cursor"
                    Value="IBeam"/>

            <Setter Property="Validation.ErrorTemplate"
                    Value="{StaticResource error-outstanding}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid>
                            <!--BORDER-->
                            <Border UseLayoutRounding="True" 
                                    Background="{TemplateBinding BorderBrush}"/>

                            <!--ACCENT-->
                            <Border UseLayoutRounding="True" 
                                    Background="{TemplateBinding extra:AccentsExtra.Color}"
                                    Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>

                            <!--BACKGROUND-->
                            <Border UseLayoutRounding="False" 
                                    Background="{TemplateBinding Background}"
                                    Margin="{TemplateBinding BorderThickness}"/>

                            <!--TEXT PRESENTER-->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Visibility="{TemplateBinding extra:TextBoxesExtra.PresenterVisibility}"
                                          Style="{StaticResource scrollviewer-min}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <!--TEXT HOLDER-->
                            <TextBlock Text="{TemplateBinding Text}"
                                       Visibility="{TemplateBinding extra:TextBoxesExtra.WrapperVisibility}"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="1.5,0"
                                       Width="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>

                            <!--PLACE HOLDER-->
                            <TextBlock Text="{TemplateBinding extra:TextBoxesExtra.Placeholder}"
                                       Visibility="{TemplateBinding extra:TextBoxesExtra.PlaceholderVisibility}"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="1.5,0"
                                       Width="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Opacity="0.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
                <Trigger.Setters>
                    <Setter Property="extra:TextBoxesExtra.PresenterVisibility" 
                            Value="Visible"/>
                    <Setter Property="extra:TextBoxesExtra.WrapperVisibility" 
                            Value="Hidden"/>
                </Trigger.Setters>
            </Trigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text, Converter={x:Static helpers:Converters.IsNullOrEmpty}}"
                         Value="True">
                <Setter Property="extra:TextBoxesExtra.PlaceholderVisibility" 
                        Value="Visible"/>
            </DataTrigger>

            <Trigger Property="IsFocused" Value="True">
                <Trigger.Setters>
                    <Setter Property="extra:TextBoxesExtra.PresenterVisibility" 
                            Value="Visible"/>
                    <Setter Property="extra:TextBoxesExtra.WrapperVisibility" 
                            Value="Hidden"/>
                    <Setter Property="extra:TextBoxesExtra.PlaceholderVisibility" 
                            Value="Hidden"/>
                </Trigger.Setters>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="OpacityMask"
                        Value="{StaticResource S_DisabledStateMaskColorBrush_}"/>
                <Setter Property="Background"
                        Value="{StaticResource S_DefaultDisabledAccentColorBrush_}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="textbox-readonly"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource textbox-default}">
        <Style.Setters>
            <Setter Property="extra:TextBoxesExtra.PseudoAccentVisibility"
                    Value="Visible"/>
            <Setter Property="extra:TextBoxesExtra.FieldVisibility"
                    Value="Hidden"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid Background="Transparent">
                            <!--BORDER-->
                            <Border UseLayoutRounding="True"                                     
                                    Visibility="{TemplateBinding extra:TextBoxesExtra.FieldVisibility}"
                                    Background="{TemplateBinding BorderBrush}"/>

                            <!--PSEUDO ACCENT-->
                            <Border UseLayoutRounding="True" 
                                    Visibility="{TemplateBinding extra:TextBoxesExtra.PseudoAccentVisibility}"
                                    BorderBrush="{TemplateBinding extra:AccentsExtra.Color}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>
                            
                            <!--ACCENT-->
                            <Border UseLayoutRounding="True" 
                                    Visibility="{TemplateBinding extra:TextBoxesExtra.FieldVisibility}"
                                    Background="{TemplateBinding extra:AccentsExtra.Color}"
                                    Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"/>

                            <!--BACKGROUND-->
                            <Border UseLayoutRounding="False" 
                                    Visibility="{TemplateBinding extra:TextBoxesExtra.FieldVisibility}"
                                    Background="{TemplateBinding Background}"
                                    Margin="{TemplateBinding BorderThickness}"/>

                            <!--TEXT PRESENTER-->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Visibility="{TemplateBinding extra:TextBoxesExtra.PresenterVisibility}"
                                          Style="{StaticResource scrollviewer-min}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <!--TEXT HOLDER-->
                            <TextBlock Text="{TemplateBinding Text}"
                                       Visibility="{TemplateBinding extra:TextBoxesExtra.WrapperVisibility}"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="1.5,0"
                                       Width="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>

                            <!--PLACE HOLDER-->
                            <TextBlock Text="{TemplateBinding extra:TextBoxesExtra.Placeholder}"
                                       Visibility="{TemplateBinding extra:TextBoxesExtra.PlaceholderVisibility}"
                                       Padding="{TemplateBinding Padding}"
                                       Margin="1.5,0"
                                       Width="{Binding ElementName=PART_ContentHost, Path=ActualWidth}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Opacity="0.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Trigger.Setters>
                    <Setter Property="extra:TextBoxesExtra.PresenterVisibility" 
                            Value="Visible"/>
                    <Setter Property="extra:TextBoxesExtra.WrapperVisibility" 
                            Value="Hidden"/>
                    <Setter Property="extra:TextBoxesExtra.PlaceholderVisibility" 
                            Value="Hidden"/>
                    <Setter Property="extra:TextBoxesExtra.PseudoAccentVisibility" 
                            Value="Hidden"/>
                    <Setter Property="extra:TextBoxesExtra.FieldVisibility" 
                            Value="Visible"/>
                </Trigger.Setters>
            </Trigger>
            
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="OpacityMask"
                        Value="{StaticResource S_DisabledStateMaskColorBrush_}"/>
                <Setter Property="Background"
                        Value="{StaticResource S_DefaultDisabledAccentColorBrush_}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource S_DisabledBorderColorNoOpacityBrush_}"/>
                
                <Setter Property="extra:TextBoxesExtra.PseudoAccentVisibility" 
                            Value="Hidden"/>
                <Setter Property="extra:TextBoxesExtra.FieldVisibility" 
                            Value="Visible"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    
    
</ResourceDictionary>