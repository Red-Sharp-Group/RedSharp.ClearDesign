<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="separator-horizontal"
           TargetType="{x:Type Separator}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>

            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

            <Setter Property="Margin"
                    Value="{DynamicResource D_DefaultMarginThicknessLeftRight_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="separator-vertical"
           TargetType="{x:Type Separator}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>

            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>
            
            <Setter Property="Margin"
                    Value="{DynamicResource D_DefaultMarginThicknessTopBottom_}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="separator-horizontal-full"
           TargetType="{x:Type Separator}"
           BasedOn="{StaticResource separator-horizontal}">
        <Style.Setters>
            <Setter Property="Margin"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="separator-vertical-full"
           TargetType="{x:Type Separator}"
           BasedOn="{StaticResource separator-vertical}">
        <Style.Setters>
            <Setter Property="Margin"
                    Value="0"/>
        </Style.Setters>
    </Style>
    
</ResourceDictionary>