<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="GroupBoxDefault"
           TargetType="{x:Type GroupBox}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{DynamicResource BrushPanelsBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushDefaultForeground}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource FontHeader}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeHeader6}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightHeader6}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushDefaultBorder}"/>
            <Setter Property="BorderThickness"
                    Value="{DynamicResource SizeDefaultBorderAll}"/>

            <Setter Property="utils:Panel.BorderBrush"
                    Value="{DynamicResource BrushPanelsBorder}"/>
            <Setter Property="utils:Panel.BorderThickness"
                    Value="{DynamicResource SizeDefaultBorderAll}"/>

            <Setter Property="utils:Control.CornerRadius"
                    Value="{DynamicResource SizePanelRadiusAll}"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ContentPresenter Grid.Row="0" 
                                              UseLayoutRounding="False"
                                              Focusable="False"
                                              Margin="{DynamicResource SizeDefaultMarginAll}"
                                              Content="{TemplateBinding Header}"/>

                            <controls:RoundBorder Grid.Row="1" 
                                                  UseLayoutRounding="False" 
                                                  EnableChildClipping="True"
                                                  UseOuterCornerRadius="False"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding utils:Control.CornerRadius}">
                                <Grid>
                                    <controls:RoundBorder UseLayoutRounding="False"
                                                          UseOuterCornerRadius="True"
                                                          Opacity="0.2"
                                                          Background="{TemplateBinding Background}"
                                                          CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>

                                    <ContentPresenter UseLayoutRounding="False"
                                                      Focusable="False"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding Content}"/>

                                    <controls:RoundBorder UseLayoutRounding="False"
                                                          IsHitTestVisible="False"
                                                          UseOuterCornerRadius="True"
                                                          BorderBrush="{TemplateBinding utils:Panel.BorderBrush}"
                                                          BorderThickness="{TemplateBinding utils:Panel.BorderThickness}"
                                                          CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>
                                </Grid>
                            </controls:RoundBorder>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style TargetType="{x:Type GroupBox}"
           BasedOn="{StaticResource GroupBoxDefault}"/>
</ResourceDictionary>