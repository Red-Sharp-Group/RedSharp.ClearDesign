    <Style x:Key="LoaderDockTiny"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource LoaderTiny}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <Grid>
                            <Grid x:Name="PART_Loader"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ContentPresenter Grid.Column="1" 
                                                  Grid.Row="0" 
                                                  Content="{TemplateBinding utils:DockContent.Top}"/>
                                
                                <ContentPresenter Grid.Column="0" 
                                                  Grid.Row="1" 
                                                  Content="{TemplateBinding utils:DockContent.Left}"/>

                                <Ellipse Grid.Column="1" 
                                         Grid.Row="1" 
                                         Height="{TemplateBinding utils:Loader.Size}"
                                         Width="{TemplateBinding utils:Loader.Size}"
                                         Stroke="{TemplateBinding Background}"
                                         StrokeThickness="{TemplateBinding utils:Loader.Thickness}"
                                         Opacity="0.5"/>

                                <controls:Arc Grid.Column="1" 
                                              Grid.Row="1" 
                                              Style="{StaticResource __ArcLoader}"
                                              Height="{TemplateBinding utils:Loader.Size}"
                                              Width="{TemplateBinding utils:Loader.Size}" 
                                              Stroke="{TemplateBinding utils:Loader.Fill}" 
                                              StrokeThickness="{TemplateBinding utils:Loader.Thickness}"
                                              utils:Loader.IsActive="{TemplateBinding utils:Loader.IsActive}"/>

                                <ContentPresenter Grid.Column="2" 
                                                  Grid.Row="1" 
                                                  Content="{TemplateBinding utils:DockContent.Right}"/>
                                
                                <ContentPresenter Grid.Column="1" 
                                                  Grid.Row="2" 
                                                  Content="{TemplateBinding utils:DockContent.Bottom}"/>
                            </Grid>

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="utils:Loader.IsActive"
                                     Value="False">
                                <Setter TargetName="PART_Loader"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                                <Setter TargetName="PART_ContentPresenter"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="utils:Loader.IsActive"
                                     Value="True">
                                <Setter TargetName="PART_Loader"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="PART_ContentPresenter"
                                        Property="Visibility"
                                        Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

