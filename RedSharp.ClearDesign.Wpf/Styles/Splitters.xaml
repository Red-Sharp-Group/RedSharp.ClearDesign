<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:extra="clr-namespace:RedSharp.ClearDesign.Extra">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="gridsplitter-vertical"
           TargetType="{x:Type GridSplitter}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>

            <Setter Property="Width"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding}"/>

            <Setter Property="extra:AccentsExtra.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="extra:AccentsExtra.Opacity"
                    Value="0.0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Grid Margin="-2,0"
                              Background="Transparent">

                            <Rectangle Fill="{TemplateBinding extra:AccentsExtra.Color}"
                                       Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"
                                       Width="{TemplateBinding Width}"
                                       Margin="2,0"/>
                            
                            <Rectangle Fill="{TemplateBinding Background}"
                                       Width="{TemplateBinding Width}"
                                       Margin="2,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="gridsplitter-horizontal"
           TargetType="{x:Type GridSplitter}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>

            <Setter Property="Height"
                    Value="{DynamicResource D_DefaultBorder_}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource focus-outstanding}"/>

            <Setter Property="extra:AccentsExtra.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="extra:AccentsExtra.Opacity"
                    Value="0.0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Grid Margin="0,-2"
                              Background="Transparent">

                            <Rectangle Fill="{TemplateBinding extra:AccentsExtra.Color}"
                                       Opacity="{TemplateBinding extra:AccentsExtra.Opacity}"
                                       Height="{TemplateBinding Height}"
                                       Margin="0,2"/>
                            
                            <Rectangle Fill="{TemplateBinding Background}"
                                       Height="{TemplateBinding Height}"
                                       Margin="0,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>