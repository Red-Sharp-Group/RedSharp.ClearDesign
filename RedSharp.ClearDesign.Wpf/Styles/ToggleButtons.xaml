<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>

        <ResourceDictionary Source="Animations.xaml"/>
        <ResourceDictionary Source="Shadows.xaml"/>
        <ResourceDictionary Source="Focuses.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ToggleButtonDefault" 
           TargetType="{x:Type ToggleButton}">
        <Style.Setters>
            <Setter Property="MinWidth"
                Value="{DynamicResource SizeDefaultMinWidth}"/>
            <Setter Property="MinHeight"
                Value="{DynamicResource SizeDefaultMinHeight}"/>

            <Setter Property="Padding"
                Value="{DynamicResource SizeDefaultPaddingLeftRight}"/>

            <Setter Property="BorderThickness"
                Value="{DynamicResource SizeDefaultBorderAll}"/>

            <Setter Property="HorizontalAlignment"
                Value="Center"/>
            <Setter Property="VerticalAlignment"
                Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="Background"
                Value="{DynamicResource BrushElementsBackground}"/>
            <Setter Property="BorderBrush"
                Value="{DynamicResource BrushElementsBorder}"/>
            <Setter Property="Foreground"
                Value="{DynamicResource BrushDefaultForeground}"/>


            <Setter Property="FontFamily"
                Value="{DynamicResource FontText}"/>
            <Setter Property="FontSize"
                Value="{DynamicResource SizeText}"/>
            <Setter Property="FontWeight"
                Value="{DynamicResource WeightText}"/>


            <Setter Property="utils:Control.CornerRadius"
                Value="{DynamicResource SizeDefaultRadiusAll}"/>

            <Setter Property="utils:Highlight.Fill"
                Value="{DynamicResource BrushHighlightBackground}"/>
            <Setter Property="utils:Highlight.Opacity"
                Value="0.0"/>

            <Setter Property="SnapsToDevicePixels" 
                Value="False"/>
            <Setter Property="UseLayoutRounding" 
                Value="True"/>

            <Setter Property="Effect" 
                Value="{StaticResource ShadowDefault}"/>

            <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusDefaultOutstanding}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <!--BACKGROUND-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>

                            <!--HIGHLIGHT-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                Background="{TemplateBinding utils:Highlight.Fill}"
                                                CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                Opacity="{TemplateBinding utils:Highlight.Opacity}"/>

                            <ContentPresenter UseLayoutRounding="False"
                                              Focusable="False"                                             
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderBrush"
                        Value="Transparent"/>
                <Setter Property="Effect" 
                        Value="{x:Null}"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity"
                    Value="0.40"/>
                <Setter Property="Background"
                    Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="Foreground"
                    Value="{DynamicResource BrushDisabledForeground}"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Effect" 
                        Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ToggleButton}" 
           BasedOn="{StaticResource ToggleButtonDefault}"/>

    <Style x:Key="ToggleButtonMenuToolBar"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToggleButtonDefault}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="ToggleButtonAltDefault"
           TargetType="{x:Type ToggleButton}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="{DynamicResource SizeDefaultMinWidth}"/>
            <Setter Property="MinHeight"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>

            <Setter Property="Padding"
                    Value="{DynamicResource SizeDefaultPaddingLeftRight}"/>

            <Setter Property="BorderThickness"
                    Value="{DynamicResource SizeDefaultBorderAll}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource BrushElementsBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushElementsBorder}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushDefaultForeground}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource FontText}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeText}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightText}"/>


            <Setter Property="utils:Control.CornerRadius"
                    Value="{DynamicResource SizeDefaultRadiusAll}"/>

            <Setter Property="utils:Highlight.Fill"
                    Value="{DynamicResource BrushHighlightBackground}"/>
            <Setter Property="utils:Highlight.Opacity"
                    Value="0.0"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="Effect" 
                    Value="{StaticResource ShadowDefault}"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource FocusDefaultOutstanding}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <!--BACKGROUND-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>

                            <!--HIGHLIGHT-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                    Background="{TemplateBinding utils:Highlight.Fill}"
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                    Opacity="{TemplateBinding utils:Highlight.Opacity}"/>

                            <ContentPresenter x:Name="PART_RegularContent" 
                                              UseLayoutRounding="False"
                                              Focusable="False"                                             
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"/>

                            <ContentPresenter x:Name="PART_AlternativeContent" 
                                              UseLayoutRounding="False"
                                              Focusable="False"                                             
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding utils:Content.Alternative}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="False">
                                <Setter TargetName="PART_RegularContent"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="PART_AlternativeContent"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="PART_RegularContent"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                                <Setter TargetName="PART_AlternativeContent"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity"
                        Value="0.40"/>
                <Setter Property="Background"
                        Value="{DynamicResource BrushDisabledBackground}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource BrushDisabledForeground}"/>
                <Setter Property="Effect"
                        Value="{x:Null}"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToggleButtonAltPrimary"
           TargetType="{x:Type ToggleButton}" 
           BasedOn="{StaticResource ToggleButtonAltDefault}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{DynamicResource BrushPrimaryBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushPrimaryBorder}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushPrimaryForeground}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="ToggleButtonAltMenu"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToggleButtonAltDefault}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="Effect"
                    Value="{x:Null}"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource FocusDefault}"/>
        </Style.Setters>
    </Style>

    <Style x:Key="ToggleButtonAltIcon"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToggleButtonAltDefault}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>

            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="ToggleButtonAltPrimaryIcon"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToggleButtonAltPrimary}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>

            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="ToggleButtonAltMenuIcon"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToggleButtonAltMenu}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>

            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

    <Style x:Key="ToggleButtonAltMenuToolBar"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToggleButtonAltMenu}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="0"/>
        </Style.Setters>
    </Style>

</ResourceDictionary>