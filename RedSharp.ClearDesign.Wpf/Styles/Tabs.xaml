<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Colors.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Styles/Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="tabcontrol-title"
           TargetType="{x:Type TabControl}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{StaticResource S_BackgroundColorBrush_}"/>
            
            <Setter Property="BorderBrush"
                    Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            <Setter Property="BorderThickness"
                    Value="{Binding Source={StaticResource S_DefaultBorderThicknessTop_}, Path=Value}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Column="0"
                                      Grid.Row="0"
                                      ZIndex="1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Margin="50,0"/>

                            <Border Grid.Column="0"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    Margin="0,-1,0,0">
                                <Border BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentControl Content="{TemplateBinding SelectedContent}" />                                    
                                </Border>                            
                            </Border>
                            
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            
        </Style.Triggers>
    </Style>
    
    <Style x:Key="tabitem-title"
           TargetType="{x:Type TabItem}">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="80"/>
            <Setter Property="Height"
                    Value="31"/>            
            <Setter Property="Padding"
                    Value="{Binding Source={StaticResource S_DefaultPaddingThicknessLeftRight_}, Path=Value}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource S_CommonFontColorBrush_}"/>
            
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="{Binding Source={StaticResource S_DefaultBorderThicknessLeftRight_}, Path=Value}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource D_DefaultCommonFontFamily_}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource D_DefaultCommonFontSize_}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource D_DefaultCommonFontWeight_}"/>

            <Setter Property="helpers:AccentHelper.Color"
                    Value="{StaticResource S_DefaultDarkAccentColorBrush_}"/>
            <Setter Property="helpers:AccentHelper.Opacity"
                    Value="0.0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border UseLayoutRounding="True"
                                    Background="{TemplateBinding Background}">
                                <Border UseLayoutRounding="False"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                </Border>
                            </Border>

                            <Border UseLayoutRounding="True"
                                    Background="{TemplateBinding helpers:AccentHelper.Color}"
                                    Opacity="{TemplateBinding helpers:AccentHelper.Opacity}"/>

                            <ContentControl UseLayoutRounding="False" 
                                            Focusable="False"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Content="{TemplateBinding Header}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentHoverEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentHoverExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <StaticResource ResourceKey="S_AccentPressedEnterAnimation"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StaticResource ResourceKey="S_AccentPressedExitAnimation"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="{StaticResource S_BackgroundColorBrush_}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource S_SecondaryBorderColorBrush_}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>