<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>

        <ResourceDictionary Source="Animations.xaml"/>
        <ResourceDictionary Source="Thumbs.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
        <ResourceDictionary Source="Buttons.xaml"/>
        <ResourceDictionary Source="ToggleButtons.xaml"/>
        <ResourceDictionary Source="Panels.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ToolBarTrayDefault"
           TargetType="{x:Type ToolBarTray}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="Transparent"/>
        </Style.Setters>
    </Style>

    <Style TargetType="{x:Type ToolBarTray}"
           BasedOn="{StaticResource ToolBarTrayDefault}"/>

    <Style x:Key="__ThumbToolBar"
           TargetType="{x:Type Thumb}"
           BasedOn="{StaticResource ThumbDefault}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <!--BACKGROUND-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>

                            <!--HIGHLIGHT-->
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                    Background="{TemplateBinding utils:Highlight.Fill}"
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"
                                                    Opacity="{TemplateBinding utils:Highlight.Opacity}"/>

                            <Image Width="16"
                                   Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Source="{StaticResource DrawingImageToolBarThumb}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style x:Key="ToolBarDefault"
           TargetType="{x:Type ToolBar}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{DynamicResource BrushPanelsBackground}"/>

            <Setter Property="utils:Control.CornerRadius"
                    Value="{DynamicResource SizePanelRadiusAll}"/>
            
            <Setter Property="Padding"
                    Value="3"/>

            <Setter Property="Margin"
                    Value="{DynamicResource SizeDefaultMarginRight}"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolBar}">
                        <Grid>
                            <controls:LayeredBorder UseLayoutRounding="False" 
                                                    UseOuterCornerRadius="False"
                                                    Opacity="0.5"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="{TemplateBinding utils:Control.CornerRadius}"/>
                            
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Thumb x:Name="PART_ToolBarThumb"
                                       Grid.Column="0"
                                       Style="{StaticResource __ThumbToolBar}"
                                       Width="16"
                                       Height="30"/>

                                <ToolBarPanel x:Name="PART_ToolBarPanel"
                                              Grid.Column="1"
                                              IsItemsHost="true">
                                    <!--<ToolBarPanel.Resources>
                                        <ResourceDictionary>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonMenuToolBar}"/>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMenuToolBar}"/>
                                        </ResourceDictionary>
                                    </ToolBarPanel.Resources>-->
                                </ToolBarPanel>

                                <ToggleButton x:Name="PART_OverflowButton"
                                              Grid.Column="2" 
                                              Style="{StaticResource ToggleButtonAltMenuIcon}" 
                                              MinWidth="16"
                                              MinHeight="30"
                                              Visibility="Collapsed"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Content>
                                        <Image MaxWidth="16"
                                               MaxHeight="16"
                                               Source="{StaticResource DrawingImageSimpleArrowDown}"/>
                                    </ToggleButton.Content>
                                    <utils:Content.Alternative>
                                        <Image MaxWidth="16"
                                               MaxHeight="16"
                                               Source="{StaticResource DrawingImageSimpleArrowTop}"/>
                                    </utils:Content.Alternative>
                                </ToggleButton>

                                <Popup AllowsTransparency="True"
                                       HorizontalOffset="-12"
                                       UseLayoutRounding="True"
                                       PlacementTarget="{Binding ElementName=PART_OverflowButton}"
                                       IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ContentControl Style="{StaticResource PanelPopupLeft}">
                                        <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel"
                                                              
                                                              Margin="5"
                                                              WrapWidth="200"
                                                              Focusable="true"
                                                              FocusVisualStyle="{x:Null}"
                                                              KeyboardNavigation.TabNavigation="Cycle"
                                                              KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ContentControl>
                                </Popup>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ToolBarTray.IsLocked"
                                     Value="true">
                                <Setter TargetName="PART_ToolBarThumb"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasOverflowItems"
                                     Value="True">
                                <Setter TargetName="PART_OverflowButton"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <Style TargetType="{x:Type ToolBar}"
           BasedOn="{StaticResource ToolBarDefault}"/>
    
</ResourceDictionary>