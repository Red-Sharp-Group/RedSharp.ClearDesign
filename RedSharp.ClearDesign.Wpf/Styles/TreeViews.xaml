<ResourceDictionary x:Class="RedSharp.ClearDesign.Wpf.Styles.TreeViews"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="http://red-sharp.org/clear-design/utils"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Fonts.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        
        <ResourceDictionary Source="Focuses.xaml"/>
        <ResourceDictionary Source="Animations.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>        
        <ResourceDictionary Source="ScrollViewers.xaml"/>
        <ResourceDictionary Source="ToggleButtons.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <Style x:Key="TreeViewItemDefault"
           TargetType="{x:Type TreeViewItem}">
        <Style.Setters>
            <Setter Property="MinHeight"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource BrushDefaultForeground}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource FontText}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeText}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightText}"/>

            <Setter Property="utils:Highlight.Fill"
                    Value="{DynamicResource BrushHighlightBackground}"/>
            <Setter Property="utils:Highlight.Opacity"
                    Value="0.0"/>

            <Setter Property="VirtualizingPanel.IsVirtualizing" 
                    Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" 
                    Value="Recycling" />

            <Setter Property="utils:Selection.Fill"
                    Value="{DynamicResource BrushSelectedBackground}"/>
            <Setter Property="utils:Selection.Opacity"
                    Value="0.0"/>

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource FocusDefault}"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid MinHeight="{TemplateBinding MinHeight}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="{DynamicResource SizeDefaultMinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--BACKGROUND-->
                            <Border Background="{TemplateBinding Background}"
                                    Opacity="0.20"/>

                            <!--HIGHLIGHT-->
                            <Border Background="{TemplateBinding utils:Highlight.Fill}"
                                    Opacity="{TemplateBinding utils:Highlight.Opacity}"/>

                            <!--SELECTION-->
                            <Border Background="{TemplateBinding utils:Selection.Fill}"
                                    Opacity="{TemplateBinding utils:Selection.Opacity}"/>

                            <Grid Initialized="OnTreeViewItemInitialized">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="PART_Expander"
                                        Grid.Column="0"
                                        Width="30">
                                    <ToggleButton Style="{StaticResource ToggleButtonAltMenuIcon}" 
                                                  MinWidth="20"
                                                  MinHeight="20"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Content>
                                            <Image MaxWidth="16"
                                                   MaxHeight="16"
                                                   Source="{StaticResource DrawingImageSimpleArrowRight}"/>
                                        </ToggleButton.Content>
                                        <utils:Content.Alternative>
                                            <Image MaxWidth="16"
                                                   MaxHeight="16"
                                                   Source="{StaticResource DrawingImageSimpleArrowDown}"/>
                                        </utils:Content.Alternative>
                                    </ToggleButton>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  UseLayoutRounding="False"
                                                  x:Name="PART_Header"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  ContentSource="Header"/>
                            </Grid>

                            <ItemsPresenter Grid.Row="1"
                                            x:Name="ItemsHost"/>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Expander" 
                                        Property="Visibility" 
                                        Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" 
                                        Property="Visibility" 
                                        Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionHovered"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions>
                    <utils:DoubleAnimationGenerator IsEnter="True">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <utils:DoubleAnimationGenerator IsEnter="False">
                        <StaticResource ResourceKey="AnimationDescriptionPressed"/>
                    </utils:DoubleAnimationGenerator>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="utils:Selection.Opacity"
                        Value="0.5"/>
            </Trigger>
            <Trigger Property="ItemsControl.AlternationIndex" 
                     Value="1">
                <Setter Property="Background" 
                        Value="{DynamicResource BrushPanelsBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TreeViewDefault"
           TargetType="{x:Type TreeView}">
        <Style.Setters>
            <Setter Property="AlternationCount"
                    Value="2"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource TreeViewItemDefault}"/>

            <Setter Property="VirtualizingPanel.IsVirtualizing" 
                    Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" 
                    Value="Recycling" />

            <Setter Property="ScrollViewer.CanContentScroll" 
                    Value="True" />

            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource FocusDefault}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeView}">
                        <ScrollViewer Style="{StaticResource ScrollViewerDefault}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      Focusable="false">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
    
    <Style TargetType="{x:Type TreeView}"
           BasedOn="{StaticResource TreeViewDefault}"/>
    
</ResourceDictionary>