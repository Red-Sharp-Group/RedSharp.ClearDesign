<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="http://red-sharp.org/clear-design/controls">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Definitions/Brushes.xaml"/>
        <ResourceDictionary Source="../Definitions/Sizes.xaml"/>
        <ResourceDictionary Source="Shadows.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ItemsControlItemDefault"
           TargetType="{x:Type ContentControl}">
        <Style.Setters>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="MinHeight"
                    Value="{DynamicResource SizeDefaultMinHeight}"/>
            <Setter Property="Padding"
                    Value="{DynamicResource SizeDefaultPaddingLeftRight}"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource BrushDefaultForeground}"/>

            <Setter Property="FontFamily"
                    Value="{DynamicResource FontText}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource SizeText}"/>
            <Setter Property="FontWeight"
                    Value="{DynamicResource WeightText}"/>

            <Setter Property="SnapsToDevicePixels" 
                    Value="False"/>
            <Setter Property="UseLayoutRounding" 
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <Grid>
                            <Border BorderThickness="0"
                                    Background="{TemplateBinding Background}"
                                    Opacity="0.20"/>

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ItemsControl.AlternationIndex)}"
                         Value="1">
                <Setter Property="Background" 
                        Value="{DynamicResource BrushPanelsBackground}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ItemsControlDefault"
           TargetType="{x:Type ItemsControl}">
        <Style.Setters>
            <Setter Property="AlternationCount"
                    Value="2"/>
        </Style.Setters>
    </Style>

    <Style TargetType="{x:Type ItemsControl}"
           BasedOn="{StaticResource ItemsControlDefault}"/>
</ResourceDictionary>