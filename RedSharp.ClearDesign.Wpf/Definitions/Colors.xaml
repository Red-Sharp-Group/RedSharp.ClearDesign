<ResourceDictionary x:Class="RedSharp.ClearDesign.Definitions.Colors"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers">

    <!--################################################################################################################-->
    <!--COLORS DEFINITIONS-->
    <!--The next set of colors is all colors that used in the application on they are basic for another colors.-->
    <!--If you want to modify your theme you have to change only that colors.-->

    <Color x:Key="D_DefaultPrimaryColor_">#FF3B99FC</Color>
    <Color x:Key="D_DefaultSecondaryColor_">#FFF1F1F1</Color>

    <Color x:Key="D_DefaultBackgroundColor_">#FFFAFAFA</Color>
    <Color x:Key="D_DefaultFieldsColor_">#FFFFFFFF</Color>
    <Color x:Key="D_DefaultToggleColor_">#FF444444</Color>

    <Color x:Key="D_DefaultPrimaryFontColor_">#FFFAFAFA</Color>
    <Color x:Key="D_DefaultSecondaryFontColor_">#FF141414</Color>

    <Color x:Key="D_DefaultErrorColor_">#FFF54343</Color>
    <Color x:Key="D_DefaultWarningColor_">#FFF4C343</Color>
    <Color x:Key="D_DefaultSuccessColor_">#FF88DD60</Color>

    <Color x:Key="D_DefaultLightAccentColor_">#FFFFFFFF</Color>
    <Color x:Key="D_DefaultDarkAccentColor_">#FF000000</Color>
    <Color x:Key="D_DefaultDisabledAccentColor_">#FFBBBBBB</Color>
    <Color x:Key="D_DefaultStepAccentColor_">#FF000000</Color>

    <Color x:Key="D_DisabledStateMaskColor_">#66FFFFFF</Color>

    <!--################################################################################################################-->
    <!--COLORS DEFINITIONS BRUSHERS-->
    <!--The brushes for the previous set of colors, has to be used in the styling.-->

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--MAIN COLOR-->

    <SolidColorBrush x:Key="S_PrimaryColorBrush_" 
                     Color="{DynamicResource D_DefaultPrimaryColor_}"/>
    <SolidColorBrush x:Key="S_SecondaryColorBrush_" 
                     Color="{DynamicResource D_DefaultSecondaryColor_}"/>

    <SolidColorBrush x:Key="S_BackgroundColorBrush_" 
                     Color="{DynamicResource D_DefaultBackgroundColor_}"/>
    <SolidColorBrush x:Key="S_FieldsColorBrush_" 
                     Color="{DynamicResource D_DefaultFieldsColor_}"/>
    <SolidColorBrush x:Key="S_ToggleColorBrush_" 
                     Color="{DynamicResource D_DefaultToggleColor_}"/>

    <SolidColorBrush x:Key="S_PrimaryFontColorBrush_" 
                     Color="{DynamicResource D_DefaultPrimaryFontColor_}"/>
    <SolidColorBrush x:Key="S_SecondaryFontColorBrush_" 
                     Color="{DynamicResource D_DefaultSecondaryFontColor_}"/>

    <SolidColorBrush x:Key="S_ErrorColorBrush_" 
                     Color="{DynamicResource D_DefaultErrorColor_}"/>
    <SolidColorBrush x:Key="S_WarningColorBrush_" 
                     Color="{DynamicResource D_DefaultWarningColor_}"/>
    <SolidColorBrush x:Key="S_SuccessColorBrush_" 
                     Color="{DynamicResource D_DefaultSuccessColor_}"/>

    <SolidColorBrush x:Key="S_DefaultLightAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultLightAccentColor_}"/>
    <SolidColorBrush x:Key="S_DefaultDarkAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultDarkAccentColor_}"/>
    <SolidColorBrush x:Key="S_DefaultDisabledAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultDisabledAccentColor_}"/>
    <SolidColorBrush x:Key="S_DefaultStepAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultStepAccentColor_}"/>

    <SolidColorBrush x:Key="S_DisabledStateMaskColorBrush_"
                     Color="{DynamicResource D_DisabledStateMaskColor_}"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--LIGHT ACCENT COLOR-->

    <!--COMPUTED: D_DefaultLightAccentColor_(Alpha 5%)-->
    <utils:OpacityModifier x:Key="D_Light1Modifier_">D_Light1Color_ = D_DefaultLightAccentColor_ (5%)</utils:OpacityModifier>
    <Color x:Key="D_Light1Color_">#0DFFFFFF</Color>

    <!--COMPUTED: D_DefaultLightAccentColor_(Alpha 10%)-->
    <utils:OpacityModifier x:Key="D_Light2Modifier_">D_Light2Color_ = D_DefaultLightAccentColor_ (10%)</utils:OpacityModifier>
    <Color x:Key="D_Light2Color_">#1AFFFFFF</Color>

    <!--COMPUTED: D_DefaultLightAccentColor_(Alpha 15%)-->
    <utils:OpacityModifier x:Key="D_Light3Modifier_">D_Light3Color_ = D_DefaultLightAccentColor_ (15%)</utils:OpacityModifier>
    <Color x:Key="D_Light3Color_">#26FFFFFF</Color>

    <!--COMPUTED: D_DefaultLightAccentColor_(Alpha 20%)-->
    <utils:OpacityModifier x:Key="D_Light4Modifier_">D_Light4Color_ = D_DefaultLightAccentColor_ (20%)</utils:OpacityModifier>
    <Color x:Key="D_Light4Color_">#33FFFFFF</Color>

    <!--COMPUTED: D_DefaultLightAccentColor_(Alpha 25%)-->
    <utils:OpacityModifier x:Key="D_Light5Modifier_">D_Light5Color_ = D_DefaultLightAccentColor_ (25%)</utils:OpacityModifier>
    <Color x:Key="D_Light5Color_">#40FFFFFF</Color>

    <SolidColorBrush x:Key="S_Light1ColorBrush_"
                     Color="{DynamicResource D_Light1Color_}"/>
    <SolidColorBrush x:Key="S_Light2ColorBrush_"
                     Color="{DynamicResource D_Light2Color_}"/>
    <SolidColorBrush x:Key="S_Light3ColorBrush_"
                     Color="{DynamicResource D_Light3Color_}"/>
    <SolidColorBrush x:Key="S_Light4ColorBrush_"
                     Color="{DynamicResource D_Light4Color_}"/>
    <SolidColorBrush x:Key="S_Light5ColorBrush_"
                     Color="{DynamicResource D_Light5Color_}"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--DARK ACCENT COLOR-->

    <!--COMPUTED: D_DefaultDarkAccentColor_(Alpha 5%)-->
    <utils:OpacityModifier x:Key="D_Dark1Modifier_">D_Dark1Color_ = D_DefaultDarkAccentColor_ (5%)</utils:OpacityModifier>
    <Color x:Key="D_Dark1Color_">#0D000000</Color>

    <!--COMPUTED: D_DefaultDarkAccentColor_(Alpha 10%)-->
    <utils:OpacityModifier x:Key="D_Dark2Modifier_">D_Dark2Color_ = D_DefaultDarkAccentColor_ (10%)</utils:OpacityModifier>
    <Color x:Key="D_Dark2Color_">#1A000000</Color>

    <!--COMPUTED: D_DefaultDarkAccentColor_(Alpha 15%)-->
    <utils:OpacityModifier x:Key="D_Dark3Modifier_">D_Dark3Color_ = D_DefaultDarkAccentColor_ (15%)</utils:OpacityModifier>
    <Color x:Key="D_Dark3Color_">#26000000</Color>

    <!--COMPUTED: D_DefaultDarkAccentColor_(Alpha 20%)-->
    <utils:OpacityModifier x:Key="D_Dark4Modifier_">D_Dark4Color_ = D_DefaultDarkAccentColor_ (20%)</utils:OpacityModifier>
    <Color x:Key="D_Dark4Color_">#33000000</Color>

    <!--COMPUTED: D_DefaultDarkAccentColor_(Alpha 25%)-->
    <utils:OpacityModifier x:Key="D_Dark5Modifier_">D_Dark5Color_ = D_DefaultDarkAccentColor_ (25%)</utils:OpacityModifier>
    <Color x:Key="D_Dark5Color_">#40000000</Color>

    <SolidColorBrush x:Key="S_Dark1ColorBrush_"
                     Color="{DynamicResource D_Dark1Color_}"/>
    <SolidColorBrush x:Key="S_Dark2ColorBrush_"
                     Color="{DynamicResource D_Dark2Color_}"/>
    <SolidColorBrush x:Key="S_Dark3ColorBrush_"
                     Color="{DynamicResource D_Dark3Color_}"/>
    <SolidColorBrush x:Key="S_Dark4ColorBrush_"
                     Color="{DynamicResource D_Dark4Color_}"/>
    <SolidColorBrush x:Key="S_Dark5ColorBrush_"
                     Color="{DynamicResource D_Dark5Color_}"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--DISABLED ACCENT COLOR-->

    <!--COMPUTED: D_DefaultDisabledAccentColor_(Alpha 10%)-->
    <utils:OpacityModifier x:Key="D_Disabled1Modifier_">D_Disabled1Color_ = D_DefaultDisabledAccentColor_ (10%)</utils:OpacityModifier>
    <Color x:Key="D_Disabled1Color_">#1ABBBBBB</Color>

    <!--COMPUTED: D_DefaultDisabledAccentColor_(Alpha 25%)-->
    <utils:OpacityModifier x:Key="D_Disabled2Modifier_">D_Disabled2Color_ = D_DefaultDisabledAccentColor_ (25%)</utils:OpacityModifier>
    <Color x:Key="D_Disabled2Color_">#40BBBBBB</Color>

    <!--COMPUTED: D_DefaultDisabledAccentColor_(Alpha 40%)-->
    <utils:OpacityModifier x:Key="D_Disabled3Modifier_">D_Disabled3Color_ = D_DefaultDisabledAccentColor_ (40%)</utils:OpacityModifier>
    <Color x:Key="D_Disabled3Color_">#66BBBBBB</Color>

    <!--COMPUTED: D_DefaultDisabledAccentColor_(Alpha 55%)-->
    <utils:OpacityModifier x:Key="D_Disabled4Modifier_">D_Disabled4Color_ = D_DefaultDisabledAccentColor_ (55%)</utils:OpacityModifier>
    <Color x:Key="D_Disabled4Color_">#8CBBBBBB</Color>

    <!--COMPUTED: D_DefaultDisabledAccentColor_(Alpha 70%)-->
    <utils:OpacityModifier x:Key="D_Disabled5Modifier_">D_Disabled5Color_ = D_DefaultDisabledAccentColor_ (70%)</utils:OpacityModifier>
    <Color x:Key="D_Disabled5Color_">#B3BBBBBB</Color>

    <SolidColorBrush x:Key="S_Disabled1ColorBrush_"
                     Color="{DynamicResource D_Disabled1Color_}"/>
    <SolidColorBrush x:Key="S_Disabled2ColorBrush_"
                     Color="{DynamicResource D_Disabled2Color_}"/>
    <SolidColorBrush x:Key="S_Disabled3ColorBrush_"
                     Color="{DynamicResource D_Disabled3Color_}"/>
    <SolidColorBrush x:Key="S_Disabled4ColorBrush_"
                     Color="{DynamicResource D_Disabled4Color_}"/>
    <SolidColorBrush x:Key="S_Disabled5ColorBrush_"
                     Color="{DynamicResource D_Disabled5Color_}"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--STEP ACCENT COLOR-->

    <!--COMPUTED: D_DefaultStepAccentColor_(Alpha 3%)-->
    <utils:OpacityModifier x:Key="D_Step1Modifier_">D_Disabled1Color_ = D_DefaultStepAccentColor_ (3%)</utils:OpacityModifier>
    <Color x:Key="D_Step1Color_">#08000000</Color>

    <!--COMPUTED: D_DefaultStepAccentColor_(Alpha 6%)-->
    <utils:OpacityModifier x:Key="D_Step2Modifier_">D_Disabled2Color_ = D_DefaultStepAccentColor_ (6%)</utils:OpacityModifier>
    <Color x:Key="D_Step2Color_">#0F000000</Color>

    <!--COMPUTED: D_DefaultStepAccentColor_(Alpha 9%)-->
    <utils:OpacityModifier x:Key="D_Step3Modifier_">D_Disabled3Color_ = D_DefaultStepAccentColor_ (9%)</utils:OpacityModifier>
    <Color x:Key="D_Step3Color_">#17000000</Color>

    <!--COMPUTED: D_DefaultStepAccentColor_(Alpha 12%)-->
    <utils:OpacityModifier x:Key="D_Step4Modifier_">D_Disabled4Color_ = D_DefaultStepAccentColor_ (12%)</utils:OpacityModifier>
    <Color x:Key="D_Step4Color_">#1F000000</Color>

    <!--COMPUTED: D_DefaultStepAccentColor_(Alpha 15%)-->
    <utils:OpacityModifier x:Key="D_Step5Modifier_">D_Disabled5Color_ = D_DefaultStepAccentColor_ (15%)</utils:OpacityModifier>
    <Color x:Key="D_Step5Color_">#26000000</Color>

    <SolidColorBrush x:Key="S_Step1ColorBrush_" 
                     Color="{DynamicResource D_Step1Color_}"/>
    <SolidColorBrush x:Key="S_Step2ColorBrush_"
                     Color="{DynamicResource D_Step2Color_}"/>
    <SolidColorBrush x:Key="S_Step3ColorBrush_"
                     Color="{DynamicResource D_Step3Color_}"/>
    <SolidColorBrush x:Key="S_Step4ColorBrush_"
                     Color="{DynamicResource D_Step4Color_}"/>
    <SolidColorBrush x:Key="S_Step5ColorBrush_"
                     Color="{DynamicResource D_Step5Color_}"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--BACKGROUND COLOR-->

    <!--COMPUTED: D_DefaultBackgroundColor_ + D_Step1Color_-->
    <utils:BlendingModifier x:Key="D_Background1Modifier_">D_Background1Color_ = D_DefaultBackgroundColor_ + D_Step1Color_</utils:BlendingModifier>
    <Color x:Key="D_Background1Color_">#FFF2F2F2</Color>

    <!--COMPUTED: D_DefaultBackgroundColor_ + D_Step2Color_-->
    <utils:BlendingModifier x:Key="D_Background2Modifier_">D_Background2Color_ = D_DefaultBackgroundColor_ + D_Step2Color_</utils:BlendingModifier>
    <Color x:Key="D_Background2Color_">#FFEBEBEB</Color>

    <!--COMPUTED: D_DefaultBackgroundColor_ + D_Step3Color_-->
    <utils:BlendingModifier x:Key="D_Background3Modifier_">D_Background3Color_ = D_DefaultBackgroundColor_ + D_Step3Color_</utils:BlendingModifier>
    <Color x:Key="D_Background3Color_">#FFE4E4E4</Color>

    <!--COMPUTED: D_DefaultBackgroundColor_ + D_Step4Color_-->
    <utils:BlendingModifier x:Key="D_Background4Modifier_">D_Background4Color_ = D_DefaultBackgroundColor_ + D_Step4Color_</utils:BlendingModifier>
    <Color x:Key="D_Background4Color_">#FFDCDCDC</Color>

    <!--COMPUTED: D_DefaultBackgroundColor_ + D_Step5Color_-->
    <utils:BlendingModifier x:Key="D_Background5Modifier_">D_Background5Color_ = D_DefaultBackgroundColor_ + D_Step5Color_</utils:BlendingModifier>
    <Color x:Key="D_Background5Color_">#FFD5D5D5</Color>

    <SolidColorBrush x:Key="S_Background1ColorBrush_" 
                     Color="{DynamicResource D_Background1Color_}"/>
    <SolidColorBrush x:Key="S_Background2ColorBrush_"
                     Color="{DynamicResource D_Background2Color_}"/>
    <SolidColorBrush x:Key="S_Background3ColorBrush_"
                     Color="{DynamicResource D_Background3Color_}"/>
    <SolidColorBrush x:Key="S_Background4ColorBrush_"
                     Color="{DynamicResource D_Background4Color_}"/>
    <SolidColorBrush x:Key="S_Background5ColorBrush_"
                     Color="{DynamicResource D_Background5Color_}"/>

    <!--################################################################################################################-->
    <!--ACTION COLORS-->
    <!--Colors that was computed form another colors-->

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--SPECIAL COLORS-->

    <!--COMPUTED: D_Dark5Color_ + D_Dark5Color_-->
    <utils:BlendingModifier x:Key="D_ScrollThumbBackgroundModifier_">D_ScrollThumbBackgroundColor_ = D_Dark5Color_ + D_Dark5Color_</utils:BlendingModifier>
    <Color x:Key="D_ScrollThumbBackgroundColor_">#6F000000</Color>

    <SolidColorBrush x:Key="S_ScrollThumbBackgroundBrush_"
                     Color="{DynamicResource D_ScrollThumbBackgroundColor_}"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--BORDER COLORS-->

    <!--COMPUTED: D_DefaultPrimaryColor_ + D_Light5Color_-->
    <utils:BlendingModifier x:Key="D_FocusBorderModifier_">D_FocusBorderColor_ = D_DefaultPrimaryColor_ + D_Light5Color_</utils:BlendingModifier>
    <Color x:Key="D_FocusBorderColor_">#FF6DB3FD</Color>

    <!--COMPUTED: D_DefaultPrimaryColor_ + D_Dark5Color_-->
    <utils:BlendingModifier x:Key="D_PrimaryBorderModifier_">D_PrimaryBorderColor_ = D_DefaultPrimaryColor_ + D_Dark5Color_</utils:BlendingModifier>
    <Color x:Key="D_PrimaryBorderColor_">#FF2D73BD</Color>

    <!--COMPUTED: D_Dark5Color_-->
    <utils:BlendingModifier x:Key="D_SecondaryBorderModifier_">D_SecondaryBorderColor_ = D_Dark5Color_</utils:BlendingModifier>
    <Color x:Key="D_SecondaryBorderColor_">#40000000</Color>

    <!--COMPUTED: D_Disabled3Color_ + D_Dark4Color_-->
    <utils:BlendingModifier x:Key="D_DisabledBorderModifier_">D_DisabledBorderColor_ = D_Disabled3Color_ + D_Dark4Color_</utils:BlendingModifier>
    <Color x:Key="D_DisabledBorderColor_">#843C3C3C</Color>

    <!--COMPUTED: D_PrimaryBorderColor_(Alpha 100%)-->
    <utils:OpacityModifier x:Key="D_DisabledBorderNoOpacityModifier_">D_DisabledBorderNoOpacityColor_ = D_PrimaryBorderColor_ (100%)</utils:OpacityModifier>
    <Color x:Key="D_DisabledBorderNoOpacityColor_">#FF3C3C3C</Color>


    <SolidColorBrush x:Key="S_FocusBorderColorBrush_"
                     Color="{DynamicResource D_FocusBorderColor_}"/>
    <SolidColorBrush x:Key="S_PrimaryBorderColorBrush_"
                     Color="{DynamicResource D_PrimaryBorderColor_}"/>
    <SolidColorBrush x:Key="S_SecondaryBorderColorBrush_"
                     Color="{DynamicResource D_SecondaryBorderColor_}"/>
    <SolidColorBrush x:Key="S_DisabledBorderColorBrush_"
                     Color="{DynamicResource D_DisabledBorderColor_}"/>
    <SolidColorBrush x:Key="S_DisabledBorderColorNoOpacityBrush_"
                     Color="{DynamicResource D_DisabledBorderNoOpacityColor_}"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--FONT COLORS-->

    <!--COMPUTED: D_DefaultSecondaryFontColor_ + D_Light3Color_-->
    <utils:BlendingModifier x:Key="D_CommonFontModifier_">D_CommonFontColor_ = D_DefaultSecondaryFontColor_ + D_Light3Color_</utils:BlendingModifier>
    <Color x:Key="D_CommonFontColor_">#FF383838</Color>

    <!--Brush from the modifiers (you have to use them instead of modifiers)-->
    <SolidColorBrush x:Key="S_CommonFontColorBrush_"
                     Color="{DynamicResource D_CommonFontColor_}"/>

</ResourceDictionary>