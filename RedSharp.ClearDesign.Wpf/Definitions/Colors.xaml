<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils">

    <Color x:Key="D_DefaultPrimaryColor_">#FF3B99FC</Color>
    <Color x:Key="D_DefaultSecondaryColor_">#FFF1F1F1</Color>

    <Color x:Key="D_DefaultBackgroundColor_">#FFFAFAFA</Color>
    <Color x:Key="D_DefaultFieldsColor_">#FFFFFFFF</Color>
    <Color x:Key="D_DefaultToggleColor_">#FF444444</Color>

    <Color x:Key="D_DefaultPrimaryFontColor_">#FFFAFAFA</Color>
    <Color x:Key="D_DefaultSecondaryFontColor_">#FF141414</Color>

    <Color x:Key="D_DefaultErrorColor_">#FFF54343</Color>
    <Color x:Key="D_DefaultWarningColor_">#FFF4C343</Color>
    <Color x:Key="D_DefaultSuccessColor_">#FF88DD60</Color>

    <Color x:Key="D_DefaultLightAccentColor_">#FFFFFFFF</Color>
    <Color x:Key="D_DefaultDarkAccentColor_">#FF000000</Color>
    <Color x:Key="D_DefaultDisabledAccentColor_">#FFBBBBBB</Color>
    <Color x:Key="D_DefaultStepAccentColor_">#FF000000</Color>

    <Color x:Key="D_DisabledStateMaskColor_">#66FFFFFF</Color>

    <!--################################################################################################################-->
    <!--############################################### STANDARD COLOR #################################################-->

    <!--========================================================-->
    <!--MAIN COLOR-->

    <SolidColorBrush x:Key="S_PrimaryColorBrush_" 
                     Color="{DynamicResource D_DefaultPrimaryColor_}"/>
    <SolidColorBrush x:Key="S_SecondaryColorBrush_" 
                     Color="{DynamicResource D_DefaultSecondaryColor_}"/>

    <SolidColorBrush x:Key="S_BackgroundColorBrush_" 
                     Color="{DynamicResource D_DefaultBackgroundColor_}"/>
    <SolidColorBrush x:Key="S_FieldsColorBrush_" 
                     Color="{DynamicResource D_DefaultFieldsColor_}"/>
    <SolidColorBrush x:Key="S_ToggleColorBrush_" 
                     Color="{DynamicResource D_DefaultToggleColor_}"/>

    <SolidColorBrush x:Key="S_PrimaryFontColorBrush_" 
                     Color="{DynamicResource D_DefaultPrimaryFontColor_}"/>
    <SolidColorBrush x:Key="S_SecondaryFontColorBrush_" 
                     Color="{DynamicResource D_DefaultSecondaryFontColor_}"/>

    <SolidColorBrush x:Key="S_ErrorColorBrush_" 
                     Color="{DynamicResource D_DefaultErrorColor_}"/>
    <SolidColorBrush x:Key="S_WarningColorBrush_" 
                     Color="{DynamicResource D_DefaultWarningColor_}"/>
    <SolidColorBrush x:Key="S_SuccessColorBrush_" 
                     Color="{DynamicResource D_DefaultSuccessColor_}"/>

    <SolidColorBrush x:Key="S_DefaultLightAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultLightAccentColor_}"/>
    <SolidColorBrush x:Key="S_DefaultDarkAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultDarkAccentColor_}"/>
    <SolidColorBrush x:Key="S_DefaultDisabledAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultDisabledAccentColor_}"/>
    <SolidColorBrush x:Key="S_DefaultStepAccentColorBrush_" 
                     Color="{DynamicResource D_DefaultStepAccentColor_}"/>

    <SolidColorBrush x:Key="S_DisabledStateMaskColorBrush_"
                     Color="{DynamicResource D_DisabledStateMaskColor_}"/>

    <!--========================================================-->
    <!--LIGHT ACCENT COLOR-->

    <utils:OpacityBlender x:Key="S_Light1Blender_"
                          InputColor="{DynamicResource D_DefaultLightAccentColor_}"
                          Opacity="0.05"/>
    <utils:OpacityBlender x:Key="S_Light2Blender_"
                          InputColor="{DynamicResource D_DefaultLightAccentColor_}"
                          Opacity="0.10"/>
    <utils:OpacityBlender x:Key="S_Light3Blender_"
                          InputColor="{DynamicResource D_DefaultLightAccentColor_}"
                          Opacity="0.15"/>
    <utils:OpacityBlender x:Key="S_Light4Blender_"
                          InputColor="{DynamicResource D_DefaultLightAccentColor_}"
                          Opacity="0.20"/>
    <utils:OpacityBlender x:Key="S_Light5Blender_"
                          InputColor="{DynamicResource D_DefaultLightAccentColor_}"
                          Opacity="0.25"/>

    <SolidColorBrush x:Key="S_Light1ColorBrush_"
                     Color="{Binding Source={StaticResource S_Light1Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Light2ColorBrush_"
                     Color="{Binding Source={StaticResource S_Light2Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Light3ColorBrush_"
                     Color="{Binding Source={StaticResource S_Light3Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Light4ColorBrush_"
                     Color="{Binding Source={StaticResource S_Light4Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Light5ColorBrush_"
                     Color="{Binding Source={StaticResource S_Light5Blender_}, Path=Color}"/>

    <!--========================================================-->
    <!--DARK ACCENT COLOR-->

    <utils:OpacityBlender x:Key="S_Dark1Blender_"
                          InputColor="{DynamicResource D_DefaultDarkAccentColor_}"
                          Opacity="0.05"/>
    <utils:OpacityBlender x:Key="S_Dark2Blender_"
                          InputColor="{DynamicResource D_DefaultDarkAccentColor_}"
                          Opacity="0.10"/>
    <utils:OpacityBlender x:Key="S_Dark3Blender_"
                          InputColor="{DynamicResource D_DefaultDarkAccentColor_}"
                          Opacity="0.15"/>
    <utils:OpacityBlender x:Key="S_Dark4Blender_"
                          InputColor="{DynamicResource D_DefaultDarkAccentColor_}"
                          Opacity="0.20"/>
    <utils:OpacityBlender x:Key="S_Dark5Blender_"
                          InputColor="{DynamicResource D_DefaultDarkAccentColor_}"
                          Opacity="0.25"/>

    <SolidColorBrush x:Key="S_Dark1ColorBrush_"
                     Color="{Binding Source={StaticResource S_Dark1Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Dark2ColorBrush_"
                     Color="{Binding Source={StaticResource S_Dark2Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Dark3ColorBrush_"
                     Color="{Binding Source={StaticResource S_Dark3Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Dark4ColorBrush_"
                     Color="{Binding Source={StaticResource S_Dark4Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Dark5ColorBrush_"
                     Color="{Binding Source={StaticResource S_Dark5Blender_}, Path=Color}"/>

    <!--========================================================-->
    <!--DISABLED ACCENT COLOR-->

    <utils:OpacityBlender x:Key="S_Disabled1Blender_"
                          InputColor="{DynamicResource D_DefaultDisabledAccentColor_}"
                          Opacity="0.10"/>
    <utils:OpacityBlender x:Key="S_Disabled2Blender_"
                          InputColor="{DynamicResource D_DefaultDisabledAccentColor_}"
                          Opacity="0.25"/>
    <utils:OpacityBlender x:Key="S_Disabled3Blender_"
                          InputColor="{DynamicResource D_DefaultDisabledAccentColor_}"
                          Opacity="0.40"/>
    <utils:OpacityBlender x:Key="S_Disabled4Blender_"
                          InputColor="{DynamicResource D_DefaultDisabledAccentColor_}"
                          Opacity="0.55"/>
    <utils:OpacityBlender x:Key="S_Disabled5Blender_"
                          InputColor="{DynamicResource D_DefaultDisabledAccentColor_}"
                          Opacity="0.70"/>

    <SolidColorBrush x:Key="S_Disabled1ColorBrush_"
                     Color="{Binding Source={StaticResource S_Disabled1Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Disabled2ColorBrush_"
                     Color="{Binding Source={StaticResource S_Disabled2Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Disabled3ColorBrush_"
                     Color="{Binding Source={StaticResource S_Disabled3Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Disabled4ColorBrush_"
                     Color="{Binding Source={StaticResource S_Disabled4Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Disabled5ColorBrush_"
                     Color="{Binding Source={StaticResource S_Disabled5Blender_}, Path=Color}"/>

    <!--========================================================-->
    <!--STEP ACCENT COLOR-->

    <utils:OpacityBlender x:Key="S_Step1Blender_"
                          InputColor="{DynamicResource D_DefaultStepAccentColor_}"
                          Opacity="0.03"/>
    <utils:OpacityBlender x:Key="S_Step2Blender_"
                          InputColor="{DynamicResource D_DefaultStepAccentColor_}"
                          Opacity="0.06"/>
    <utils:OpacityBlender x:Key="S_Step3Blender_"
                          InputColor="{DynamicResource D_DefaultStepAccentColor_}"
                          Opacity="0.09"/>
    <utils:OpacityBlender x:Key="S_Step4Blender_"
                          InputColor="{DynamicResource D_DefaultStepAccentColor_}"
                          Opacity="0.12"/>
    <utils:OpacityBlender x:Key="S_Step5Blender_"
                          InputColor="{DynamicResource D_DefaultStepAccentColor_}"
                          Opacity="0.15"/>

    <SolidColorBrush x:Key="S_Step1ColorBrush_" 
                     Color="{Binding Source={StaticResource S_Step1Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Step2ColorBrush_"
                     Color="{Binding Source={StaticResource S_Step2Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Step3ColorBrush_"
                     Color="{Binding Source={StaticResource S_Step3Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Step4ColorBrush_"
                     Color="{Binding Source={StaticResource S_Step4Blender_}, Path=Color}"/>
    <SolidColorBrush x:Key="S_Step5ColorBrush_"
                     Color="{Binding Source={StaticResource S_Step5Blender_}, Path=Color}"/>
    
    <!--################################################################################################################-->
    <!--################################################ ACTION COLOR ##################################################-->

    <utils:ColorBlender x:Key="S_ScrollThumbBackgroundBlender_"
                        BackgroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_ScrollThumbBackgroundBrush_"
                     Color="{Binding Source={StaticResource S_ScrollThumbBackgroundBlender_}, Path=Color}"/>
    <!--BORDER COLOR-->

    <utils:ColorBlender x:Key="S_FocusBorderBlender_"
                        BackgroundColor="{DynamicResource D_DefaultPrimaryColor_}"
                        ForegroundColor="{Binding Source={StaticResource S_Light5Blender_}, Path=Color}"/>


    <utils:ColorBlender x:Key="S_PrimaryBorderBlender_"
                        BackgroundColor="{DynamicResource D_DefaultPrimaryColor_}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_DisabledBorderBlender_"
                        BackgroundColor="{Binding Source={StaticResource S_Disabled3ColorBrush_}, Path=Color}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark4ColorBrush_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_FocusBorderColorBrush_"
                     Color="{Binding Source={StaticResource S_FocusBorderBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_PrimaryBorderColorBrush_"
                     Color="{Binding Source={StaticResource S_PrimaryBorderBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_SecondaryBorderColorBrush_"
                     Color="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_DisabledBorderColorBrush_"
                     Color="{Binding Source={StaticResource S_DisabledBorderBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_DisabledBorderColorNoOpacityBrush_"
                     Color="{DynamicResource D_DefaultDisabledAccentColor_}"/>

    <!--HOVER-->
    <utils:ColorBlender x:Key="S_HoverPrimaryBackgroundBlender_"
                         BackgroundColor="{DynamicResource D_DefaultPrimaryColor_}"
                         ForegroundColor="{Binding Source={StaticResource S_Dark3ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_HoverSecondaryBackgroundBlender_"
                         BackgroundColor="{DynamicResource D_DefaultSecondaryColor_}"
                         ForegroundColor="{Binding Source={StaticResource S_Dark3ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_HoverSecondaryBorderBlender_"
                         BackgroundColor="{Binding Source={StaticResource S_SecondaryBorderColorBrush_}, Path=Color}"
                         ForegroundColor="{Binding Source={StaticResource S_Dark3ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_HoverFieldsBackgroundBlender_"
                         BackgroundColor="{DynamicResource D_DefaultFieldsColor_}"
                         ForegroundColor="{Binding Source={StaticResource S_Dark3ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_HoverScrollButtonBackgroundBlender_"
                         BackgroundColor="{Binding Source={StaticResource S_Step3ColorBrush_}, Path=Color}"
                         ForegroundColor="{Binding Source={StaticResource S_Dark3ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_HoverScrollThumbBackgroundBlender_"
                         BackgroundColor="{Binding Source={StaticResource S_ScrollThumbBackgroundBrush_}, Path=Color}"
                         ForegroundColor="{Binding Source={StaticResource S_Dark3ColorBrush_}, Path=Color}"/>
    
    <SolidColorBrush x:Key="S_HoverPrimaryBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_HoverPrimaryBackgroundBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_HoverSecondaryBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_HoverSecondaryBackgroundBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_HoverSecondaryBorderColorBrush_"
                     Color="{Binding Source={StaticResource S_HoverSecondaryBorderBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_HoverFieldsBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_HoverFieldsBackgroundBlender_ }, Path=Color}"/>

    <SolidColorBrush x:Key="S_HoverScrollButtonBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_HoverScrollButtonBackgroundBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_HoverScrollThumbBackgroundBrush_"
                     Color="{Binding Source={StaticResource S_HoverScrollThumbBackgroundBlender_}, Path=Color}"/>

    <!--PRESSED-->

    <utils:ColorBlender x:Key="S_PressedPrimaryBackgroundBlender_"
                        BackgroundColor="{DynamicResource D_DefaultPrimaryColor_}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_PressedSecondaryBackgroundBlender_"
                        BackgroundColor="{DynamicResource D_DefaultSecondaryColor_}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_PressedSecondaryBorderBlender_"
                        BackgroundColor="{Binding Source={StaticResource S_SecondaryBorderColorBrush_}, Path=Color}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_PressedFieldsBackgroundBlender_"
                        BackgroundColor="{DynamicResource D_DefaultFieldsColor_}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_PressedScrollButtonBackgroundBlender_"
                        BackgroundColor="{Binding Source={StaticResource S_Step3ColorBrush_}, Path=Color}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <utils:ColorBlender x:Key="S_PressedScrollThumbBackgroundBlender_"
                        BackgroundColor="{Binding Source={StaticResource S_ScrollThumbBackgroundBrush_}, Path=Color}"
                        ForegroundColor="{Binding Source={StaticResource S_Dark5ColorBrush_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_PressedPrimaryBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_PressedPrimaryBackgroundBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_PressedSecondaryBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_PressedSecondaryBackgroundBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_PressedSecondaryBorderColorBrush_"
                     Color="{Binding Source={StaticResource S_PressedSecondaryBorderBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_PressedFieldsBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_PressedFieldsBackgroundBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_PressedScrollButtonBackgroundColorBrush_"
                     Color="{Binding Source={StaticResource S_PressedScrollButtonBackgroundBlender_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_PressedScrollThumbBackgroundBrush_"
                     Color="{Binding Source={StaticResource S_PressedScrollThumbBackgroundBlender_}, Path=Color}"/>

    <!--FONT COLORS-->

    <utils:ColorBlender x:Key="S_CommonFontBlender_"
                        BackgroundColor="{DynamicResource D_DefaultSecondaryFontColor_}"
                        ForegroundColor="{Binding Source={StaticResource S_Light3ColorBrush_}, Path=Color}"/>

    <SolidColorBrush x:Key="S_CommonFontColorBrush_"
                     Color="{Binding Source={StaticResource S_CommonFontBlender_}, Path=Color}"/>

</ResourceDictionary>