<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
                    xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers">

    <!--#################################################################################################-->
    <!--SIZES DEFINITIONS-->
    <!--The next set of sizes is all sizes that used in the application on they are basic for another sizes.-->
    <!--If you want to modify your theme you have to change only that sizes.-->

    <system:Double x:Key="D_DefaultHeight_">30</system:Double>
    <system:Double x:Key="D_DefaultWidth_">120</system:Double>

    <system:Double x:Key="D_DefaultToggleHeight_">14</system:Double>

    <system:Double x:Key="D_DefaultMargin_">5</system:Double>
    <system:Double x:Key="D_DefaultPadding_">8</system:Double>

    <system:Double x:Key="D_DefaultBorder_">1</system:Double>
    <system:Double x:Key="D_DefaultFocus_">3</system:Double>

    <system:Double x:Key="D_DefaultAccentHoverOpacity_">0.15</system:Double>
    <system:Double x:Key="D_DefaultAccentPressedOpacity_">0.25</system:Double>
    
    <!--#################################################################################################-->
    <!--COMPUTED SIZES-->
    <!--All next sizes has to be computed using the sizes above.-->
    
    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--COMPUTED SIZES-->

    <!--Modifiers for the auto computing-->
    <utils:FocusOutstandingModifier x:Key="S_OutstandingFocus_" 
                                    Input="{DynamicResource D_DefaultFocus_}"
                                    Modifier="{DynamicResource D_DefaultBorder_}"/>

    <utils:ToggleHeightModifier x:Key="S_RoundToggleHeight_"
                                Input="{DynamicResource D_DefaultToggleHeight_}"
                                Modifier="{DynamicResource D_DefaultBorder_}"/>

    <utils:SwitchWidthModifier x:Key="S_SwitchToggleWidth_"
                               Input="{DynamicResource D_DefaultToggleHeight_}"/>
    
    <!--Cached bindings to the modifiers (see {utils:BindingResource ...})-->
    <Binding x:Key="B_OutstandingFocus_"
             Source="{StaticResource S_OutstandingFocus_}"
             Path="Value"/>

    <Binding x:Key="B_RoundToggleHeight_"
             Source="{StaticResource S_RoundToggleHeight_}"
             Path="Value"/>

    <Binding x:Key="B_SwitchToggleWidth_"
             Source="{StaticResource S_SwitchToggleWidth_}"
             Path="Value"/>
    
    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--MARGINS-->

    <!--Modifiers for the auto computing-->
    <utils:MultiplierThicknessModifier x:Key="S_DefaultMarginThicknessFull_"
                                       Modifier="{DynamicResource D_DefaultMargin_}"
                                       Input="1"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultMarginThicknessLeftRight_"
                                       Modifier="{DynamicResource D_DefaultMargin_}"
                                       Input="1,0"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultMarginThicknessTopBottom_"
                                       Modifier="{DynamicResource D_DefaultMargin_}"
                                       Input="0,1"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultMarginThicknessRight_"
                                       Modifier="{DynamicResource D_DefaultMargin_}"
                                       Input="0,0,1,0"/>

    <utils:MultiplierThicknessModifier x:Key="S_OutstandingFocusThicknessFull_"
                                       Modifier="{utils:BindingResource B_OutstandingFocus_}"
                                       Input="1"/>

    <!--Cached bindings to the modifiers (see {utils:BindingResource ...})-->
    <Binding x:Key="B_DefaultMarginThicknessFull_"
             Source="{StaticResource S_DefaultMarginThicknessFull_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultMarginThicknessLeftRight_"
             Source="{StaticResource S_DefaultMarginThicknessLeftRight_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultMarginThicknessTopBottom_"
             Source="{StaticResource S_DefaultMarginThicknessTopBottom_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultMarginThicknessRight_"
             Source="{StaticResource S_DefaultMarginThicknessRight_}"
             Path="Value"/>

    <Binding x:Key="B_OutstandingFocusThicknessFull_"
             Source="{StaticResource S_OutstandingFocusThicknessFull_}"
             Path="Value"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--PADDINGS-->

    <!--Modifiers for the auto computing-->
    <utils:MultiplierThicknessModifier x:Key="S_DefaultPaddingThicknessFull_"
                                       Modifier="{DynamicResource D_DefaultPadding_}"
                                       Input="1"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultPaddingThicknessLeft_"
                                       Modifier="{DynamicResource D_DefaultPadding_}"
                                       Input="1,0,0,0"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultPaddingThicknessLeftRight_"
                                       Modifier="{DynamicResource D_DefaultPadding_}"
                                       Input="1,0"/>

    <!--Cached bindings to the modifiers (see {utils:BindingResource ...})-->
    <Binding x:Key="B_DefaultPaddingThicknessFull_"
             Source="{StaticResource S_DefaultPaddingThicknessFull_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultPaddingThicknessLeft_"
             Source="{StaticResource S_DefaultPaddingThicknessLeft_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultPaddingThicknessLeftRight_"
             Source="{StaticResource S_DefaultPaddingThicknessLeftRight_}"
             Path="Value"/>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <!--BORDERS-->

    <!--Modifiers for the auto computing-->
    <utils:MultiplierThicknessModifier x:Key="S_DefaultBorderThicknessFull_"
                                       Modifier="{DynamicResource D_DefaultBorder_}"
                                       Input="1"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultBorderThicknessTop_"
                                       Modifier="{DynamicResource D_DefaultBorder_}"
                                       Input="0,1,0,0"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultBorderThicknessLeftRight_"
                                       Modifier="{DynamicResource D_DefaultBorder_}"
                                       Input="1,0"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultBorderThicknessLeftTopRight_"
                                       Modifier="{DynamicResource D_DefaultBorder_}"
                                       Input="1,1,1,0"/>

    <utils:MultiplierThicknessModifier x:Key="S_DefaultFocusThicknessFull_"
                                       Modifier="{DynamicResource D_DefaultFocus_}"
                                       Input="1"/>

    <!--Cached bindings to the modifiers (see {utils:BindingResource ...})-->
    <Binding x:Key="B_DefaultBorderThicknessFull_"
             Source="{StaticResource S_DefaultBorderThicknessFull_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultBorderThicknessTop_"
             Source="{StaticResource S_DefaultBorderThicknessTop_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultBorderThicknessLeftRight_"
             Source="{StaticResource S_DefaultBorderThicknessLeftRight_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultBorderThicknessLeftTopRight_"
             Source="{StaticResource S_DefaultBorderThicknessLeftTopRight_}"
             Path="Value"/>

    <Binding x:Key="B_DefaultFocusThicknessFull_"
             Source="{StaticResource S_DefaultFocusThicknessFull_}"
             Path="Value"/>
    
</ResourceDictionary>