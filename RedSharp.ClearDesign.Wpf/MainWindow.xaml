<Window x:Class="RedSharp.ClearDesign.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RedSharp.ClearDesign.Wpf"
        xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" 
        Width="800"
        Style="{StaticResource Test}"
        Background="{StaticResource S_WindowBackgroundColorBrush_}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="Resources/Images/ApplicationLogo.png"
                   Width="16"
                   Height="16"
                   Margin="0"/>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource textblock-common}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0">
                Local Print Service
            </TextBlock>

            <Rectangle Grid.Column="2"
                       Style="{StaticResource rectange-separator-vertical}"/>

            <Button Grid.Column="3"
                    Style="{StaticResource button-menu-icon}">
                <Path Style="{StaticResource icon-default}"
                      Data="{StaticResource S_StopIconGeometry_}"
                      Stroke="#F54343"
                      StrokeThickness="1"
                      Fill="#88F54343"/>
            </Button>

            <Button Grid.Column="4"
                    Style="{StaticResource button-menu-icon}">
                <Path Style="{StaticResource icon-default}"
                      Data="{StaticResource S_UpdateIconGeometry_}"
                      StrokeThickness="0"
                      Fill="#656565"/>
            </Button>
        </Grid>
        
        <TabControl Grid.Row="0"
                    Grid.RowSpan="2"
                    Style="{StaticResource tabcontrol-title}"
                    helpers:TabPanelHelper.Margin="197,0,0,0">
            <TabItem Style="{StaticResource tabitem-title}"
                     Header="Jobs">
                <StackPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource button-secondary}"
                        Margin="5">AWERSOME</Button>
                    <Button Style="{StaticResource button-menu}"
                        Margin="5">AWERSOME</Button>

                    <StackPanel HorizontalAlignment="Center">

                        <RadioButton Style="{StaticResource radiobutton-default}" 
                                     Margin="5" 
                                     Content="First awersome option"
                                     HorizontalAlignment="Left"/>

                        <RadioButton Style="{StaticResource radiobutton-default}" 
                                     Margin="5" 
                                     Content="Second awersome option"
                                     HorizontalAlignment="Left"/>

                        <RadioButton Style="{StaticResource radiobutton-default}" 
                                     Margin="5" 
                                     Content="Third awersome option"
                                     HorizontalAlignment="Left"/>
                    </StackPanel>
                    
                </StackPanel>
            </TabItem>
            <TabItem Style="{StaticResource tabitem-title}"
                     Header="Printers">
                <ScrollViewer Style="{StaticResource scrollviewer-default}"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Visible">
                    <Grid Width="3600"
                          Height="2048">
                        <Rectangle Fill="red"
                                   Margin="50"
                                   Width="120"
                                   Height="1920"/>
                    </Grid>
                </ScrollViewer>                
            </TabItem>
            <TabItem Style="{StaticResource tabitem-title}"
                     Header="Settings">
            </TabItem>
            <TabItem Style="{StaticResource tabitem-title}"
                     Header="About">
            </TabItem>
        </TabControl>
    </Grid>
</Window>
