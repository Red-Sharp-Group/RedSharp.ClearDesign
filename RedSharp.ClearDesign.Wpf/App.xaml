<Application x:Class="RedSharp.ClearDesign.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RedSharp.ClearDesign.Wpf"
             xmlns:utils="clr-namespace:RedSharp.ClearDesign.Utils"
             xmlns:helpers="clr-namespace:RedSharp.ClearDesign.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Definitions/Colors.xaml"/>
                <ResourceDictionary Source="Definitions/Sizes.xaml"/>
                <ResourceDictionary Source="Styles/Windows.xaml"/>
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/ItemsControls.xaml"/>
                <ResourceDictionary Source="Styles/GroupBoxes.xaml"/>
                <ResourceDictionary Source="Styles/RepeatButtons.xaml"/>
                <ResourceDictionary Source="Styles/ScrollBars.xaml"/>
                <ResourceDictionary Source="Styles/ScrollViewers.xaml"/>
                <ResourceDictionary Source="Styles/Tabs.xaml"/>
                <ResourceDictionary Source="Styles/TextBlocks.xaml"/>
                <ResourceDictionary Source="Styles/Toggles.xaml"/>
                <ResourceDictionary Source="Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <utils:ColorBlendingModifier x:Key="S_WindowBackgroundBlender_" 
                                         Input="{DynamicResource D_DefaultBackgroundColor_}"
                                         Modifier="{DynamicResource D_Step1Color_}"/>

            <SolidColorBrush x:Key="S_WindowBackgroundColorBrush_"
                             Color="{Binding Source={StaticResource S_WindowBackgroundBlender_}, Path=Value}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
